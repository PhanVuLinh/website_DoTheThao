.no-access-wrapper
  .no-access-card
    .no-access-icon
      i.fa-solid.fa-lock

    h2.no-access-title Truy cập bị từ chối

    p.no-access-desc
      | Bạn không có quyền truy cập vào trang này.
      br
      | Vui lòng liên hệ quản trị viên để được cấp quyền phù hợp.
    
    if pathAdmin
      .no-access-action
        a.btn-back(href=`/${pathAdmin}/dashboard`)
          i.fa-solid.fa-arrow-left
          | Quay về trang tổng quan
