doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title} | #{settingWebsiteInfo && settingWebsiteInfo.websiteName ? settingWebsiteInfo.websiteName : 'TitiSport'} Admin
    
    if(settingWebsiteInfo && settingWebsiteInfo.favicon)
      link(rel="icon" type="image/x-icon" href=settingWebsiteInfo.favicon)

    link(
      rel="stylesheet" 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      )

    link(
      rel="stylesheet"
      href="/admin/assets/css/style.css"
    )

    link(
      rel="stylesheet"
      href="/common/css/animations.css?v=1.0.0"
    )

    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" 
      rel="stylesheet"
    )

  body
    block main

    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/admin/assets/js/script.js") 
    script(src="/common/js/animations.js?v=1.0.0")
