include ./switch-status.pug

mixin category-tree(items, level = 0)
  each item in items
    - const prefix = Array(level + 1).join('-- ')
    
    tr
      td.text-center
        input(type="checkbox" value=item.id name="id" check-item)
      
      td.font-weight-600 #{prefix}#{item.title}
      
      td
        if item.thumbnail
          img.td-thumbnail(
            src=item.thumbnail 
            alt=item.title 
            onerror="this.src='https://placehold.co/100x100/f1f5f9/64748b?text=DM'"
          )
          
      td #{item.position}
      
      td
        +switch-status(item, `/${pathAdmin}/category/change-multi`, "category_edit")
      
      td
        .user-date
          if item.createdByFullName
            span.name #{item.createdByFullName}
            span.time #{item.createdAtFormat}
            
      td
        .user-date
          if item.updatedByFullName
            span.name #{item.updatedByFullName}
            span.time #{item.updatedAtFormat}

      if(role && role.permissions && (role.permissions.includes("category_edit") || role.permissions.includes("category_delete")))
        td
          .action-btns
            if(role && role.permissions && role.permissions.includes("category_edit"))
              a(href=`/${pathAdmin}/category/edit/${item.id}` title="Chỉnh sửa danh mục").btn-action.btn-edit
                i.fa-regular.fa-pen-to-square

            if(role && role.permissions && role.permissions.includes("category_delete"))
              button.btn-action.btn-delete(button-delete data-id=item.id title="Xóa danh mục")
                i.fa-regular.fa-trash-can
            
    if item.children && item.children.length > 0
      +category-tree(item.children, level + 1)