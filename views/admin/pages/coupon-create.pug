extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  if(role && role.permissions && role.permissions.includes("coupon_create"))
    +alert-error(3000)
    
    .page-header
      h1.page-title Tạo mã giảm giá
      a.btn-back(href=`/${pathAdmin}/coupon/list`) 
        i.fa-solid.fa-arrow-left
        | Quay lại danh sách

    .form-card
      form(action=`/${pathAdmin}/coupon/create` method="POST")
        .form-row-2
          .form-group
            label Tên sự kiện <span style="color:#ef4444">*</span>
            input.form-control(
              type="text" 
              name="title" 
              placeholder="Ví dụ: Sự kiện Noel 2025" 
              value=oldData.title || ""
              required
            )
          
          .form-group
            label Mã giảm giá <span style="color:#ef4444">*</span>
            input.form-control.text-uppercase(
              type="text" 
              name="code" 
              placeholder="Ví dụ: NOEL2025" 
              value=oldData.code || ""
              required
            )

        .form-row-2
          .form-group
            label % Giảm giá <span style="color:#ef4444">*</span>
            input.form-control(
              type="number" 
              name="discountPercentage" 
              min="0" 
              max="100" 
              value=oldData.discountPercentage !== undefined ? oldData.discountPercentage : "0"
              required
            )
          
          .form-group
            label Giảm tối đa (VNĐ)
            .input-currency-wrapper
              input.form-control(
                type="text" 
                inputmode="numeric" 
                input-currency 
                name="maxDiscountAmount" 
                placeholder="Ví dụ: 100.000" 
                min="0" 
                value=oldData.maxDiscountAmount !== undefined ? oldData.maxDiscountAmount : "0" 
              )
              span.input-currency-suffix đ

        .form-row-2
          .form-group
            label Số lượng <span style="color:#ef4444">*</span>
            input.form-control(
              type="number" 
              name="quantity" 
              min="1" 
              value=oldData.quantity || "1"
              required
            )
          
          .form-group
            label Ngày hết hạn <span style="color:#ef4444">*</span>
            input.form-control(
              type="date" 
              name="expirationDate" 
              value=oldData.expirationDate || ""
              required
            )

        .form-row-2
          .form-group
            label Trạng thái
            select.form-control(name="status")
              option(value="active" selected=(oldData.status !== "inactive")) Hoạt động
              option(value="inactive" selected=(oldData.status === "inactive")) Tạm dừng
          
          .form-group 

        .form-actions
          button.btn-submit(type="submit") Tạo mới
  else
    include ../partials/no-access.pug