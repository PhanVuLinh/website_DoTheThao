extends ../layouts/default.pug
include ../mixins/alert.pug
include ../mixins/filter-date-range.pug
include ../mixins/bulk-action.pug
include ../mixins/pagination.pug

block main
  if(role && role.permissions && role.permissions.includes("contact_view"))
    +alert-success(3000)
    +alert-error(3000)
    
    h1.page-title Quản lý Liên Hệ & Khách Hàng Tư Vấn
    .filter-action-card
      .filter-row
        .filter-label
          i.fa-solid.fa-filter
          span Bộ lọc
          
        +filter-date-range()
          
        button.btn-clear(filter-reset)
          i.fa-solid.fa-rotate-right
          | Xóa bộ lọc
      .action-row
        - 
          var bulkOptions = [];
          if(role && role.permissions) {
            if(role.permissions.includes("contact_delete")) {
              bulkOptions.push({ value: "delete-all", label: "Xóa" });
            }
          }

        if(bulkOptions.length > 0)
          +bulk-action(bulkOptions)
          
        .search-box-large
          i.fa-solid.fa-magnifying-glass
          input(type="text" placeholder="Tìm kiếm theo email..." search)
          
        .action-buttons-right
          if(role && role.permissions && role.permissions.includes("contact_trash"))
            a(href=`/${pathAdmin}/contact/trash`).btn-trash
              i.fa-regular.fa-trash-can
              | Thùng rác

    .table-section
      .table-responsive
        table.admin-table.table-hover
          thead
            tr
              th.text-center(width="50px")
                input(type="checkbox" check-all)
              th(width="180px") Khách hàng
              th(width="200px") Email
              th Nội dung / Lời nhắn
              th(width="150px") Ngày gửi
              if(role && role.permissions && role.permissions.includes("contact_delete"))
                th.text-center(width="100px") Hành động
          
          tbody
            if contactList && contactList.length > 0
              each item in contactList
                tr
                  td.text-center
                    input(type="checkbox" value=item.id name="id" check-item)
                  td
                    if item.fullName
                      div(style="font-weight: 600; color: #0f172a;") #{item.fullName}
                      if item.phone
                        div(style="font-size: 12px; color: #64748b;")
                          i.fa-solid.fa-phone(style="font-size: 11px; margin-right: 4px;")
                          | #{item.phone}
                    else
                      span.badge.badge-info(style="font-size: 11px;") Bản tin ưu đãi
                  td.font-weight-600 #{item.email}
                  td
                    if item.content
                      p(style="margin: 0; font-size: 13px; color: #334155; line-height: 1.4; max-width: 400px;") #{item.content}
                    else
                      span.text-muted(style="font-size: 12px; font-style: italic;") Đăng ký nhận bản tin khuyến mãi
                  td
                    .user-date
                      span.time #{item.createdAtFormat}
                  if(role && role.permissions && role.permissions.includes("contact_delete"))
                    td.text-center
                      .action-btns(style="justify-content: center;")
                        button.btn-delete(button-delete data-id=item.id title="Xóa liên hệ này")
                          i.fa-regular.fa-trash-can
            else 
              tr
                td(colspan="6")
                  .admin-empty-state
                    .empty-icon
                      i.fa-solid.fa-envelope-open-text
                    h4.empty-title Chưa có email đăng ký nào
                    p.empty-desc Danh sách email nhận tin từ khách hàng sẽ hiển thị tại đây khi có người đăng ký.
                
    .admin-pagination
      +pagination(pagination)

    if(role && role.permissions && role.permissions.includes("contact_delete"))
      form(
        action=""
        method="POST"
        id="form-delete-item"
        data-path=`/${pathAdmin}/contact/delete`
      )

    if(role && role.permissions && role.permissions.includes("contact_delete"))
      form(
        action=""
        method="POST"
        id="form-change-multi"
        data-path=`/${pathAdmin}/contact/change-multi`
      )
        input(type="hidden" name="type")
        input(type="hidden" name="ids")
  else
    .no-access-wrapper
      .no-access-card
        .no-access-icon
          i.fa-solid.fa-lock

        h2.no-access-title Truy cập bị từ chối

        p.no-access-desc
          | Bạn không có quyền truy cập vào trang này.
          br
          | Vui lòng liên hệ quản trị viên để được cấp quyền phù hợp.