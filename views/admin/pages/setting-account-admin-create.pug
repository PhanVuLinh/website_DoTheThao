extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  if(role && role.permissions && role.permissions.includes("account_admin_create"))
    +alert-error(3000)
    .page-header
      h1.page-title Tạo tài khoản quản trị
      a.btn-back(href=`/${pathAdmin}/setting/account-admin/list`) 
        i.fa-solid.fa-arrow-left
        | Quay lại danh sách

    .form-card
      form(action=`/${pathAdmin}/setting/account-admin/create` method="POST" enctype="multipart/form-data")
        .form-row-2
          .form-group
            label Họ tên <span style="color:#ef4444">*</span>
            input.form-control(
              type="text" 
              name="fullName" 
              placeholder="Nhập họ tên" 
              value=oldData.fullName || "" 
              required 
              minlength="2"
            )
          
          .form-group
            label Email <span style="color:#ef4444">*</span>
            input.form-control(
              type="email" 
              name="email" 
              placeholder="Nhập email" 
              value=oldData.email || "" 
              required
            )
        
        .form-row-2
          .form-group
            label Số điện thoại
            input.form-control(type="text" name="phone" placeholder="Nhập số điện thoại" value=oldData.phone || "")
          
          .form-group
            label Nhóm quyền <span style="color:#ef4444">*</span>
            select.form-control(name="role_id" required)
              option(value="" disabled selected=!oldData.role_id) -- Chọn nhóm quyền --
              each item in roles
                option(value=item.id selected=(oldData.role_id == item.id)) #{item.name}

        .form-row-2
          .form-group
            label Chức vụ
            input.form-control(type="text" name="jobTitle" placeholder="Nhập chức vụ" value=oldData.jobTitle || "")
          
          .form-group
            label Trạng thái
            select.form-control(name="status")
              option(value="active" selected=(oldData.status !== "inactive")) Hoạt động
              option(value="inactive" selected=(oldData.status === "inactive")) Tạm dừng

        .form-row-2
          .form-group
            label Mật khẩu <span style="color:#ef4444">*</span>
            input.form-control(
              type="password" 
              name="password" 
              placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" 
              required 
              minlength="6"
            )
          
          .form-group 

        .form-group(style="margin-top: 10px;")
          label Ảnh đại diện
          .upload-image-wrapper
            input#avatar-upload.hidden-input(type="file" name="avatar" accept="image/*" onchange="previewImage(event, 'preview-avatar', 'avatar-container', 'avatar-label')")
            
            label.upload-box(for="avatar-upload" id="avatar-label")
              i.fa-solid.fa-plus
              
            .image-preview-container.hidden#avatar-container
              img#preview-avatar(src="" alt="Preview")
              button.btn-remove-image(type="button" onclick="removeImage('avatar-upload', 'preview-avatar', 'avatar-container', 'avatar-label')" title="Xóa ảnh")
                i.fa-solid.fa-xmark

        .form-actions-stacked
          button.btn-submit.btn-submit-large(type="submit") Tạo mới
  else
    .no-access-wrapper
      .no-access-card
        .no-access-icon
          i.fa-solid.fa-lock

        h2.no-access-title Truy cập bị từ chối

        p.no-access-desc
          | Bạn không có quyền truy cập vào trang này.
          br
          | Vui lòng liên hệ quản trị viên để được cấp quyền phù hợp.