extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  if(role && role.permissions && role.permissions.includes("dashboard_view"))
    +alert-success(3000)
    +alert-error(3000)

    .dashboard-hero
      .hero-text
        h1.page-title Tổng quan hệ thống
        p.page-subtitle Theo dõi các chỉ số kinh doanh và hoạt động quản trị trong thời gian thực.
      .hero-date
        i.fa-regular.fa-calendar
        span Hôm nay, #{new Date().toLocaleDateString('vi-VN')}

    .stat-widgets
      .widget-card.widget-admin
        .widget-icon.bg-indigo
          i.fa-solid.fa-user-shield
        .widget-info
          span.label Quản trị viên
          h3.value #{section1.totalAdmin || 0}
          span.widget-subtext Tài khoản đang hoạt động

      .widget-card.widget-users
        .widget-icon.bg-blue
          i.fa-solid.fa-users
        .widget-info
          span.label Khách hàng
          h3.value #{section1.totalUser || 0}
          span.widget-subtext Thành viên trên hệ thống

      .widget-card.widget-orders
        .widget-icon.bg-amber
          i.fa-solid.fa-cart-shopping
        .widget-info
          span.label Tổng đơn hàng
          h3.value #{section1.totalOrder || 0}
          span.widget-subtext Đơn hàng đã ghi nhận

      .widget-card.widget-revenue
        .widget-icon.bg-emerald
          i.fa-solid.fa-coins
        .widget-info
          span.label Tổng doanh thu
          h3.value #{(section1.totalPrice || 0).toLocaleString('vi-VN')} đ
          span.widget-subtext Doanh số tích lũy

    .chart-section
      .section-header
        .section-header-left
          h2.section-title Biểu đồ doanh thu
          p.section-desc So sánh doanh thu theo ngày giữa tháng được chọn và tháng trước đó
        .section-header-right
          .chart-filter-wrap
            i.fa-regular.fa-calendar-days
            select.filter-select(id="chartMonthSelect" aria-label="Chọn tháng thống kê")
              each opt in monthOptions
                - var selected = (opt.month === chart.currentMonth && opt.year === chart.currentYear)
                option(
                  value=`${opt.month}-${opt.year}`
                  selected=selected
                ) #{opt.label}

      .chart-container(
        data-current-month=chart.currentMonth
        data-current-year=chart.currentYear
        data-prev-month=chart.prevMonth
        data-prev-year=chart.prevYear
        data-current-revenue=chart.currentMonthRevenue
        data-prev-revenue=chart.prevMonthRevenue
      )
        canvas#revenueChart

    .table-section
      .section-header
        .section-header-left
          h2.section-title Đơn hàng mới nhất
          p.section-desc Các đơn hàng vừa được đặt gần đây cần xử lý
        if(role && role.permissions && role.permissions.includes("order_view"))
          .section-header-right
            a.btn-link-action(href=`/${pathAdmin}/order/list`)
              span Xem tất cả đơn hàng
              i.fa-solid.fa-arrow-right
      
      .table-responsive
        table.admin-table.table-hover
          thead
            tr
              th Mã ĐH
              th Thông tin khách
              th Sản phẩm
              th Thanh toán
              th Trạng thái
              th Ngày đặt
              th Thao tác
          tbody
            if orderList && orderList.length
              each orderDetail in orderList
                tr
                  td
                    a.order-code(href=`/${pathAdmin}/order/edit/${orderDetail._id || orderDetail.id}`) #{orderDetail.orderCode}
                  td
                    .customer-info
                      span.font-weight-600 #{orderDetail.fullName}
                      span.phone 
                        i.fa-solid.fa-phone
                        | #{orderDetail.phone}
                  td
                    .mini-products-stack
                      each item in orderDetail.products
                        .product-mini-item
                          img(
                            src=item.thumbnail 
                            alt=item.title 
                            onerror="this.src='https://placehold.co/80x80/e2e8f0/64748b?text=SP'"
                          )
                          .prod-info
                            span.prod-name(title=item.title) #{item.title}
                            if item.size || item.quantity
                              span.prod-meta Size: #{item.size || 'Tiêu chuẩn'} | SL: #{item.quantity}
                  td
                    span.text-price #{(orderDetail.total || 0).toLocaleString('vi-VN')} đ
                  td
                    - var statusClass = orderDetail.status ? `badge-${orderDetail.status}` : 'badge-pending'
                    span.badge-status(class=statusClass) #{orderDetail.statusName}
                  td
                    span.text-muted #{orderDetail.createdAtFormat}
                  td
                    .action-btns
                      if(role && role.permissions && (role.permissions.includes("order_edit") || role.permissions.includes("order_view")))
                        a.btn-action.btn-view(href=`/${pathAdmin}/order/edit/${orderDetail._id || orderDetail.id}` title="Xem chi tiết đơn")
                          i.fa-regular.fa-eye
            else
              tr
                td(colspan="7")
                  .admin-empty-state
                    .empty-icon
                      i.fa-solid.fa-receipt
                    h4.empty-title Chưa có đơn hàng mới
                    p.empty-desc Hiện tại chưa ghi nhận đơn hàng phát sinh nào trong hệ thống.

  else
    .no-access-wrapper
      .no-access-card
        .no-access-icon
          i.fa-solid.fa-lock

        h2.no-access-title Truy cập bị từ chối

        p.no-access-desc
          | Bạn không có quyền truy cập vào trang này.
          br
          | Vui lòng liên hệ quản trị viên để được cấp quyền phù hợp.