extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  if(role && role.permissions && role.permissions.includes("dashboard_view"))
    +alert-success(3000)
    +alert-error(3000)

    .dashboard-hero
      .hero-text
        h1.page-title Tổng quan hệ thống
        p.page-subtitle Theo dõi các chỉ số kinh doanh và hoạt động quản trị trong thời gian thực.
      .hero-actions
        .hero-date
          i.fa-regular.fa-calendar
          span Hôm nay, #{new Date().toLocaleDateString('vi-VN')}
        a.btn-export-revenue(
          href=`/${pathAdmin}/dashboard/export-revenue?chartMonth=${chart.currentMonth}&chartYear=${chart.currentYear}`
          id="btnExportRevenue"
          title="Tải file Excel (CSV) báo cáo doanh thu"
        )
          i.fa-solid.fa-file-excel
          span Xuất Báo Cáo Excel

    .stat-widgets
      .widget-card.widget-admin
        .widget-icon.bg-indigo
          i.fa-solid.fa-user-shield
        .widget-info
          span.label Quản trị viên
          h3.value #{section1.totalAdmin || 0}
          span.widget-subtext Tài khoản đang hoạt động

      .widget-card.widget-users
        .widget-icon.bg-blue
          i.fa-solid.fa-users
        .widget-info
          span.label Khách hàng
          h3.value #{section1.totalUser || 0}
          span.widget-subtext Thành viên trên hệ thống

      .widget-card.widget-orders
        .widget-icon.bg-amber
          i.fa-solid.fa-cart-shopping
        .widget-info
          span.label Tổng đơn hàng
          h3.value #{section1.totalOrder || 0}
          span.widget-subtext Đơn hàng đã ghi nhận

      .widget-card.widget-revenue
        .widget-icon.bg-emerald
          i.fa-solid.fa-coins
        .widget-info
          span.label Tổng doanh thu
          h3.value #{(section1.totalPrice || 0).toLocaleString('vi-VN')} đ
          span.widget-subtext Doanh số tích lũy

    .chart-section
      .section-header
        .section-header-left
          h2.section-title Biểu đồ doanh thu
          p.section-desc So sánh doanh thu theo ngày giữa tháng được chọn và tháng trước đó
        .section-header-right
          .chart-filter-wrap
            i.fa-regular.fa-calendar-days
            select.filter-select(id="chartMonthSelect" aria-label="Chọn tháng thống kê")
              each opt in monthOptions
                - var selected = (opt.month === chart.currentMonth && opt.year === chart.currentYear)
                option(
                  value=`${opt.month}-${opt.year}`
                  selected=selected
                ) #{opt.label}

      .chart-container(
        data-current-month=chart.currentMonth
        data-current-year=chart.currentYear
        data-prev-month=chart.prevMonth
        data-prev-year=chart.prevYear
        data-current-revenue=chart.currentMonthRevenue
        data-prev-revenue=chart.prevMonthRevenue
      )
        canvas#revenueChart

    //- SECTION: HIỆU SUẤT VẬN HÀNH (4 WIDGET CARDS)
    .performance-hero-row
      .section-header
        .section-header-left
          .d-flex.align-items-center.gap-2
            .badge-icon-growth
              i.fa-solid.fa-chart-line
            h2.section-title Hiệu Suất Vận Hành
          p.section-desc Đánh giá tỷ lệ hoàn tất đơn hàng và giá trị giỏ hàng trung bình

    .stat-widgets.performance-widgets
      .widget-card.widget-kpi
        .widget-icon.bg-indigo-light
          i.fa-solid.fa-receipt
        .widget-info
          span.label Giá trị trung bình/đơn (AOV)
          h3.value #{averageOrderValue.toLocaleString('vi-VN')} đ
          span.widget-subtext Doanh thu trung bình mỗi đơn

      .widget-card.widget-kpi
        .widget-icon.bg-emerald-light
          i.fa-solid.fa-circle-check
        .widget-info
          span.label Tỷ lệ hoàn thành đơn
          h3.value.text-success #{successRate}%
          span.widget-subtext #{orderStatusCounts.done}/#{totalAllOrders} đơn thành công

      .widget-card.widget-kpi
        .widget-icon.bg-amber-light
          i.fa-solid.fa-boxes-packing
        .widget-info
          span.label Tổng sản phẩm đã bán
          h3.value #{totalItemsSold} sp
          span.widget-subtext Khách hàng đã đặt mua

      .widget-card.widget-kpi.widget-status-summary
        .widget-info
          span.label Phân bổ trạng thái đơn
          .mini-status-bars
            .status-bar-pill.pill-done
              span.dot
              span.txt Hoàn tất: <strong>#{orderStatusCounts.done}</strong>
            .status-bar-pill.pill-shipping
              span.dot
              span.txt Đang giao: <strong>#{orderStatusCounts.shipping}</strong>
            .status-bar-pill.pill-initial
              span.dot
              span.txt Chờ duyệt: <strong>#{orderStatusCounts.initial}</strong>
            .status-bar-pill.pill-cancel
              span.dot
              span.txt Đã hủy: <strong>#{orderStatusCounts.cancel}</strong>

    //- SECTION: TOP 5 SẢN PHẨM BÁN CHẠY NHẤT (FULL-WIDTH TABLE)
    .table-section.top-selling-section
      .section-header
        .section-header-left
          .d-flex.align-items-center.gap-2
            .badge-icon-trophy
              i.fa-solid.fa-trophy
            h2.section-title Top 5 Sản Phẩm Bán Chạy Nhất
            span.badge-count-success Dẫn đầu doanh số
          p.section-desc Xếp hạng mặt hàng có số lượng bán và doanh thu cao nhất trên toàn hệ thống
        if(role && role.permissions && role.permissions.includes("product_view"))
          .section-header-right
            a.btn-link-action(href=`/${pathAdmin}/product/list`)
              span Quản lý kho hàng
              i.fa-solid.fa-arrow-right

      if topSellingProducts && topSellingProducts.length
        .table-responsive
          table.admin-table.table-hover
            thead
              tr
                th(style="width: 75px; text-align: center;") Hạng
                th Sản phẩm
                th Thương hiệu
                th Đơn giá
                th(style="text-align: center;") Đã bán
                th Tổng doanh thu
                th(style="width: 180px;") Tỷ trọng bán
                th(style="text-align: center;") Xem
            tbody
              each item in topSellingProducts
                tr
                  td(style="text-align: center;")
                    span.rank-pill(class=`rank-${item.rank}`)
                      if item.rank === 1
                        i.fa-solid.fa-crown
                        |  #1
                      else
                        | ##{item.rank}
                  td
                    .product-mini-item
                      img(
                        src=item.thumbnail 
                        alt=item.title 
                        onerror="this.src='https://placehold.co/80x80/e2e8f0/64748b?text=SP'"
                      )
                      .prod-info
                        a.prod-name(href=`/product/detail/${item.slug}` target="_blank" title=item.title) #{item.title}
                  td
                    span.badge-brand #{item.brand}
                  td
                    span.font-weight-600 #{item.price.toLocaleString('vi-VN')} đ
                  td(style="text-align: center;")
                    span.badge-sold-pill #{item.soldQuantity} sp
                  td
                    span.text-price #{(item.totalRevenue || 0).toLocaleString('vi-VN')} đ
                  td
                    .sales-progress-box(title=`Chiếm ${item.percentage}% tổng lượng bán`)
                      .progress-track
                        .progress-bar-fill(style=`width: ${item.percentage}%`)
                      span.progress-text #{item.percentage}%
                  td(style="text-align: center;")
                    .action-btns.justify-content-center
                      a.btn-action.btn-view(href=`/product/detail/${item.slug}` target="_blank" title="Xem sản phẩm ngoài website")
                        i.fa-regular.fa-eye
      else
        .admin-empty-state
          .empty-icon
            i.fa-solid.fa-chart-pie
          h4.empty-title Chưa có dữ liệu bán chạy
          p.empty-desc Bảng xếp hạng sẽ tự động cập nhật khi có đơn hàng được thanh toán.

    .table-section
      .section-header
        .section-header-left
          h2.section-title Đơn hàng mới nhất
          p.section-desc Các đơn hàng vừa được đặt gần đây cần xử lý
        if(role && role.permissions && role.permissions.includes("order_view"))
          .section-header-right
            a.btn-link-action(href=`/${pathAdmin}/order/list`)
              span Xem tất cả đơn hàng
              i.fa-solid.fa-arrow-right
      
      .table-responsive
        table.admin-table.table-hover
          thead
            tr
              th Mã ĐH
              th Thông tin khách
              th Sản phẩm
              th Thanh toán
              th Trạng thái
              th Ngày đặt
              th Thao tác
          tbody
            if orderList && orderList.length
              each orderDetail in orderList
                tr
                  td
                    a.order-code(href=`/${pathAdmin}/order/edit/${orderDetail._id || orderDetail.id}`) #{orderDetail.orderCode}
                  td
                    .customer-info
                      span.font-weight-600 #{orderDetail.fullName}
                      span.phone 
                        i.fa-solid.fa-phone
                        | #{orderDetail.phone}
                  td
                    .mini-products-stack
                      each item in orderDetail.products
                        .product-mini-item
                          img(
                            src=item.thumbnail 
                            alt=item.title 
                            onerror="this.src='https://placehold.co/80x80/e2e8f0/64748b?text=SP'"
                          )
                          .prod-info
                            span.prod-name(title=item.title) #{item.title}
                            if item.size || item.quantity
                              span.prod-meta Size: #{item.size || 'Tiêu chuẩn'} | SL: #{item.quantity}
                  td
                    span.text-price #{(orderDetail.total || 0).toLocaleString('vi-VN')} đ
                  td
                    - var statusClass = orderDetail.status ? `badge-${orderDetail.status}` : 'badge-pending'
                    span.badge-status(class=statusClass) #{orderDetail.statusName}
                  td
                    span.text-muted #{orderDetail.createdAtFormat}
                  td
                    .action-btns
                      if(role && role.permissions && (role.permissions.includes("order_edit") || role.permissions.includes("order_view")))
                        a.btn-action.btn-view(href=`/${pathAdmin}/order/edit/${orderDetail._id || orderDetail.id}` title="Xem chi tiết đơn")
                          i.fa-regular.fa-eye
            else
              tr
                td(colspan="7")
                  .admin-empty-state
                    .empty-icon
                      i.fa-solid.fa-receipt
                    h4.empty-title Chưa có đơn hàng mới
                    p.empty-desc Hiện tại chưa ghi nhận đơn hàng phát sinh nào trong hệ thống.

    .table-section.low-stock-section
      .section-header
        .section-header-left
          .d-flex.align-items-center.gap-2
            h2.section-title Cảnh báo tồn kho thấp
            if lowStockCount > 0
              span.badge-count-warning #{lowStockCount} sản phẩm
          p.section-desc Các kích cỡ sản phẩm còn dưới 5 sản phẩm cần nhập thêm hoặc điều chỉnh nguồn hàng
        if(role && role.permissions && role.permissions.includes("product_view"))
          .section-header-right
            a.btn-link-action(href=`/${pathAdmin}/product/list`)
              span Quản lý kho sản phẩm
              i.fa-solid.fa-arrow-right

      .table-responsive
        table.admin-table.table-hover
          thead
            tr
              th Sản phẩm
              th Size & Số lượng cảnh báo
              th Tổng tồn kho
              th Tình trạng
              th Thao tác
          tbody
            if lowStockList && lowStockList.length
              each prod in lowStockList
                tr
                  td
                    .product-mini-item.product-lowstock-item
                      img(
                        src=prod.thumbnail 
                        alt=prod.title 
                        onerror="this.src='https://placehold.co/80x80/e2e8f0/64748b?text=SP'"
                      )
                      .prod-info
                        span.prod-name(title=prod.title) #{prod.title}
                  td
                    .sizes-stock-badges
                      each s in prod.criticalSizes
                        span.badge-size-warning(class=(s.stock <= 0 ? 'is-out' : ''))
                          | Size #{s.size.replace(/^size[:\s]*/i, "")}: 
                          strong #{s.stock <= 0 ? 'Hết hàng (0)' : `còn ${s.stock}`}
                  td
                    span.font-weight-600 #{prod.totalStock} sp
                  td
                    if prod.totalStock <= 0
                      span.badge-status.badge-danger Hết toàn bộ
                    else
                      span.badge-status.badge-warning Sắp hết hàng
                  td
                    .action-btns
                      if(role && role.permissions && role.permissions.includes("product_edit"))
                        a.btn-action.btn-edit(href=`/${pathAdmin}/product/edit/${prod._id}` title="Nhập thêm hàng / Sửa")
                          i.fa-solid.fa-pen-to-square
            else
              tr
                td(colspan="5")
                  .admin-empty-state
                    .empty-icon
                      i.fa-solid.fa-boxes-stacked
                    h4.empty-title Kho hàng ổn định
                    p.empty-desc Hiện tại tất cả sản phẩm đều có số lượng tồn kho an toàn (> 5 sản phẩm/size).

  else
    include ../partials/no-access.pug