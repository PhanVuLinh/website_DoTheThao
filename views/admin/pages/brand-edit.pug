extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  if(role && role.permissions && role.permissions.includes("brand_edit"))
    +alert-success(3000)
    +alert-error(3000)

    .page-header
      h1.page-title Chỉnh Sửa Thương Hiệu Đối Tác
      a.btn-back(href=`/${pathAdmin}/brand/list`)
        i.fa-solid.fa-arrow-left
        | Quay lại danh sách

    .form-card
      form(action=`/${pathAdmin}/brand/edit/${brand._id}?_method=PATCH` method="POST" enctype="multipart/form-data")
        .form-row-2
          .form-group
            label Tên thương hiệu <span class="text-danger">*</span>
            input.form-control(type="text" name="name" value=brand.name placeholder="Ví dụ: NIKE, ADIDAS..." required)

          .form-group
            label Câu khẩu hiệu (Tagline / Slogan)
            input.form-control(type="text" name="tagline" value=brand.tagline placeholder="Ví dụ: Just Do It...")

        .form-row-2
          .form-group
            label Đặc điểm nổi bật (Spec Pill)
            input.form-control(type="text" name="specPill" value=brand.specPill placeholder="Ví dụ: Giày Đá Bóng & Áo Đấu...")

          .form-group
            label Đường dẫn xem sản phẩm (URL)
            input.form-control(type="text" name="link" value=brand.link placeholder="Ví dụ: /?keyword=Nike")

        .form-group
          label Mô tả ngắn gọn về thương hiệu
          textarea.form-control(name="description" rows="3" placeholder="Giới thiệu nhanh về thương hiệu...")= brand.description

        .form-row-2
          .form-group
            label Vị trí hiển thị (Số nhỏ đứng trước)
            input.form-control(type="number" name="position" value=brand.position min="1")

          .form-group
            label Trạng thái
            select.form-control(name="status")
              option(value="active" selected=(brand.status === "active")) Hoạt động (Hiển thị)
              option(value="inactive" selected=(brand.status === "inactive")) Tạm dừng (Ẩn)

        .form-group
          label Logo thương hiệu (SVG hoặc PNG nền trong suốt)
          .upload-image-wrapper(upload-image-wrapper)
            input#brand-logo-edit.hidden-input(upload-image-input type="file" name="logo" accept="image/*")
            label.upload-box(for="brand-logo-edit" upload-image-label class=(brand.logo ? "hidden" : ""))
              i.fa-solid.fa-plus
            .image-preview-container(upload-image-preview-container class=(brand.logo ? "" : "hidden"))
              img(upload-image-preview src=(brand.logo || "") alt=brand.name)
              button.btn-remove-image(type="button" button-remove-image title="Xóa ảnh")
                i.fa-solid.fa-xmark

        .form-actions
          a.btn-cancel(href=`/${pathAdmin}/brand/list`) Hủy bỏ
          button.btn-submit(type="submit")
            i.fa-solid.fa-floppy-disk
            |  Cập nhật thương hiệu

  else
    include ../partials/no-access.pug
