extends ../layouts/default.pug
include ../mixins/alert.pug
include ../mixins/bulk-action.pug
include ../mixins/pagination.pug

block main
  if(role && role.permissions && (role.permissions.includes("flash_sale_trash") || role.permissions.includes("product_trash")))
    +alert-success(3000)
    +alert-error(3000)

    .page-header
      h1.page-title Thùng rác chiến dịch Flash Sale
      a.btn-back(href=`/${pathAdmin}/flash-sale/list`) 
        i.fa-solid.fa-arrow-left
        | Quay lại danh sách

    .filter-action-card
      .action-row
        - 
          var bulkOptions = [];
          if(role && role.permissions) {
            if(role.permissions.includes("flash_sale_restore") || role.permissions.includes("product_restore")) {
              bulkOptions.push({ value: "restore-all", label: "Khôi phục" });
            }
            if(role.permissions.includes("flash_sale_destroy") || role.permissions.includes("product_destroy")) {
              bulkOptions.push({ value: "delete-all", label: "Xóa vĩnh viễn" });
            }
          }

        if(bulkOptions.length > 0)
          +bulk-action(bulkOptions)

        .search-box-large
          i.fa-solid.fa-magnifying-glass
          input(type="text" placeholder="Tìm kiếm chiến dịch trong thùng rác..." search)

    .table-section
      .table-responsive
        table.admin-table.table-hover
          thead
            tr
              th.text-center(width="50px")
                input(type="checkbox" check-all)
              th Tên chiến dịch
              th Huy hiệu
              th Số sản phẩm
              th Thời gian xóa
              th Người xóa
              if(role && role.permissions && (role.permissions.includes("flash_sale_restore") || role.permissions.includes("flash_sale_destroy") || role.permissions.includes("product_restore") || role.permissions.includes("product_destroy")))
                th Hành động
          
          tbody
            if flashSaleList && flashSaleList.length > 0
              each item in flashSaleList
                tr
                  td.text-center
                    input(type="checkbox" name="id" value=item.id check-item)
                  td.font-weight-600.text-primary #{item.title}
                  td
                    span.badge-tag #{item.badge}
                  td #{item.totalProducts} sản phẩm
                  td #{item.deletedDateFormat}
                  td #{item.deletedByFullName || 'Quản trị viên'}
                  if(role && role.permissions && (role.permissions.includes("flash_sale_restore") || role.permissions.includes("flash_sale_destroy") || role.permissions.includes("product_restore") || role.permissions.includes("product_destroy")))
                    td
                      .action-btns
                        if(role && role.permissions && (role.permissions.includes("flash_sale_restore") || role.permissions.includes("product_restore")))
                          button.btn-restore(button-restore data-id=item.id title="Khôi phục")
                            i.fa-solid.fa-arrow-rotate-left
                        if(role && role.permissions && (role.permissions.includes("flash_sale_destroy") || role.permissions.includes("product_destroy")))
                          button.btn-destroy(button-destroy data-id=item.id title="Xóa vĩnh viễn")
                            i.fa-solid.fa-trash-can
            else
              tr
                td(colspan="7")
                  .admin-empty-state
                    .empty-icon
                      i.fa-regular.fa-trash-can
                    p Thùng rác chiến dịch trống

      +pagination(pagination)

    form#form-restore-item(action="" method="POST" data-path=`/${pathAdmin}/flash-sale/restore`)
    form#form-destroy-item(action="" method="POST" data-path=`/${pathAdmin}/flash-sale/delete-destroy`)
    form#form-change-multi(action="" method="POST" data-path=`/${pathAdmin}/flash-sale/change-multi-trash`)
      input(type="hidden" name="type" value="")
      input(type="hidden" name="ids" value="")
