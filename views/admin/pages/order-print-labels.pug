doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title} | #{websiteInfo && websiteInfo.websiteName ? websiteInfo.websiteName : 'TitiSport'}
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    script(src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js")
    style.
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Inter', sans-serif;
        background: #f1f5f9;
        color: #0f172a;
        padding-bottom: 40px;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      /* Floating Toolbar */
      .print-toolbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .toolbar-actions {
        display: flex;
        gap: 12px;
      }
      .btn-print {
        background: #2563eb;
        color: #ffffff;
        border: none;
        padding: 8px 18px;
        font-size: 13.5px;
        font-weight: 700;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background 0.2s;
      }
      .btn-print:hover {
        background: #1d4ed8;
      }
      .btn-close {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        padding: 8px 16px;
        font-size: 13.5px;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
      }
      .btn-close:hover {
        background: #e2e8f0;
      }
      
      /* Print Labels Container */
      .labels-wrapper {
        max-width: 800px;
        margin: 24px auto;
        display: flex;
        flex-direction: column;
        gap: 32px;
      }
      .shipping-slip {
        background: #ffffff;
        border: 2px dashed #94a3b8;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        page-break-after: always;
        break-after: page;
      }
      .shipping-slip:last-child {
        page-break-after: auto;
        break-after: auto;
      }

      /* Slip Header */
      .slip-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #0f172a;
        padding-bottom: 12px;
        margin-bottom: 12px;
      }
      .carrier-brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .carrier-logo-text {
        font-size: 20px;
        font-weight: 900;
        color: #f97316;
        letter-spacing: -0.5px;
      }
      .carrier-sub {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
      }
      .slip-order-meta {
        text-align: right;
      }
      .slip-order-meta .order-no {
        font-size: 14px;
        font-weight: 800;
        color: #0f172a;
      }
      .slip-order-meta .order-date {
        font-size: 11.5px;
        color: #64748b;
      }

      /* Barcode Area */
      .barcode-container {
        text-align: center;
        margin: 10px 0 16px 0;
        padding: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
      }
      .barcode-container svg {
        max-width: 100%;
        height: 60px;
      }
      .tracking-text {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #0f172a;
        margin-top: 4px;
      }

      /* Sender & Receiver grid */
      .address-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 14px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 14px;
      }
      .address-box {
        background: #fafafa;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 10px 12px;
      }
      .box-label {
        font-size: 11px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .box-name {
        font-size: 13.5px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 2px;
      }
      .box-phone {
        font-size: 12.5px;
        font-weight: 600;
        color: #2563eb;
        margin-bottom: 4px;
      }
      .box-address {
        font-size: 12px;
        line-height: 1.4;
        color: #334155;
      }

      /* COD Payment Callout */
      .cod-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-radius: 6px;
        margin-bottom: 14px;
        border: 2px solid;
      }
      .cod-banner.is-cod {
        background: #fffbeb;
        border-color: #f59e0b;
      }
      .cod-banner.is-paid {
        background: #ecfdf5;
        border-color: #10b981;
      }
      .cod-label {
        font-size: 13px;
        font-weight: 700;
      }
      .cod-value {
        font-size: 20px;
        font-weight: 900;
        letter-spacing: -0.5px;
      }
      .cod-banner.is-cod .cod-label { color: #b45309; }
      .cod-banner.is-cod .cod-value { color: #b45309; }
      .cod-banner.is-paid .cod-label { color: #047857; }
      .cod-banner.is-paid .cod-value { color: #047857; }

      /* Product Table */
      .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 14px;
        font-size: 12px;
      }
      .items-table th, .items-table td {
        border: 1px solid #cbd5e1;
        padding: 6px 10px;
        text-align: left;
      }
      .items-table th {
        background: #f1f5f9;
        font-weight: 700;
        color: #475569;
      }
      .items-table td.qty-col {
        text-align: center;
        font-weight: 700;
        width: 60px;
      }

      /* Instructions & Signature footer */
      .slip-footer {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
        padding-top: 8px;
        border-top: 1px dashed #cbd5e1;
        font-size: 11px;
        color: #475569;
      }
      .instruction-box strong {
        color: #0f172a;
      }
      .signature-box {
        text-align: center;
        padding-top: 4px;
      }
      .signature-space {
        height: 40px;
      }

      /* Print Optimizations */
      @media print {
        body {
          background: #ffffff;
          padding: 0;
        }
        .print-toolbar {
          display: none !important;
        }
        .labels-wrapper {
          max-width: 100%;
          margin: 0;
          gap: 0;
        }
        .shipping-slip {
          border: 1px solid #000000;
          box-shadow: none;
          margin-bottom: 0;
          padding: 16px;
        }
      }
  body
    .print-toolbar
      .toolbar-title
        i.fa-solid.fa-print
        span In Phiếu Vận Đơn & Đóng Hàng (#{orders.length} đơn)
      .toolbar-actions
        button.btn-print(onclick="window.print()")
          i.fa-solid.fa-print
          span In ngay (Print)
        a.btn-close(href="javascript:window.close()")
          i.fa-solid.fa-xmark
          span Đóng cửa sổ

    .labels-wrapper
      each order in orders
        .shipping-slip
          .slip-header
            .carrier-brand
              .carrier-logo-text
                i.fa-solid.fa-bolt(style="color: #f97316; margin-right: 4px;")
                | #{order.shippingCarrier || 'GHN EXPRESS'}
              span.carrier-sub Tiêu chuẩn vận chuyển
            .slip-order-meta
              .order-no Đơn hàng: #{order.orderCode}
              .order-date Ngày đặt: #{moment(order.createdAt).format('HH:mm - DD/MM/YYYY')}

          .barcode-container
            svg(id=`barcode-${order.orderCode}` data-code=order.trackingCode || order.orderCode)
            .tracking-text #{order.trackingCode || order.orderCode}

          .address-grid
            .address-box
              .box-label
                i.fa-solid.fa-store
                | Người gửi:
              .box-name #{websiteInfo.websiteName || 'TitiSport Official Store'}
              .box-phone Hotline: #{websiteInfo.phone || '0988.888.888'}
              .box-address #{websiteInfo.address || 'Hà Nội, Việt Nam'}

            .address-box
              .box-label
                i.fa-solid.fa-location-dot
                | Người nhận:
              .box-name #{order.fullName}
              .box-phone #{order.phone}
              .box-address #{order.address}
              if order.note
                .box-address(style="margin-top: 4px; color: #dc2626; font-weight: 600;") Ghi chú: #{order.note}

          if order.paymentStatus === 'paid'
            .cod-banner.is-paid
              .cod-label
                i.fa-solid.fa-circle-check(style="margin-right: 6px;")
                | ĐÃ THANH TOÁN ONLINE (#{order.paymentMethod ? order.paymentMethod.toUpperCase() : 'ONLINE'})
              .cod-value TIỀN THU: 0 đ
          else
            .cod-banner.is-cod
              .cod-label
                i.fa-solid.fa-hand-holding-dollar(style="margin-right: 6px;")
                | THU TIỀN NGƯỜI NHẬN (TIỀN COD)
              .cod-value #{(order.total || 0).toLocaleString('vi-VN')} đ

          table.items-table
            thead
              tr
                th(style="width: 35px; text-align: center;") STT
                th Sản phẩm & Phân loại
                th.qty-col SL
                th(style="text-align: right; width: 110px;") Thành tiền
            tbody
              if order.products && order.products.length
                each item, idx in order.products
                  tr
                    td(style="text-align: center;") #{idx + 1}
                    td
                      strong #{item.title || 'Sản phẩm thể thao'}
                      if item.size
                        span(style="color: #64748b; margin-left: 6px;") (Size: #{item.size})
                    td.qty-col #{item.quantity || 1}
                    td(style="text-align: right;") #{(item.priceNewQuantity || (item.priceNew || item.price || 0) * (item.quantity || 1)).toLocaleString('vi-VN')} đ
              tr
                td(colspan="3" style="text-align: right; font-weight: 700;") Tổng giá trị hàng hóa:
                td(style="text-align: right; font-weight: 800; color: #0f172a;") #{(order.total || 0).toLocaleString('vi-VN')} đ

          .slip-footer
            .instruction-box
              p 
                strong Chỉ dẫn giao hàng: 
                | Cho xem hàng, không cho thử hàng. Cho phép đồng kiểm.
              p
                strong Đơn vị vận chuyển: 
                | Giao Hàng Nhanh (GHN) - Hotline tra cứu: 1900 636677
            .signature-box
              p Chữ ký người nhận
              .signature-space
              p(style="font-size: 10px; color: #94a3b8;") (Ký và ghi rõ họ tên)

    script.
      // Generate Barcode for all orders
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('svg[id^="barcode-"]').forEach(function(svg) {
          var code = svg.getAttribute('data-code');
          if (code) {
            try {
              JsBarcode(svg, code, {
                format: "CODE128",
                width: 1.6,
                height: 48,
                displayValue: false,
                margin: 0
              });
            } catch(e) {
              console.error("Barcode error:", e);
            }
          }
        });
      });
