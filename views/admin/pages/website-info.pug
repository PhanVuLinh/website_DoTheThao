extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  if(role && role.permissions && (role.permissions.includes("setting_view") || role.permissions.includes("setting_edit")))
    +alert-error(3000)
    +alert-success(3000)
    
    .page-header
      h1.page-title Cấu hình Toàn diện Website & Trang chủ
      a.btn-back(href=`/${pathAdmin}/setting/list`) 
        i.fa-solid.fa-arrow-left
        | Quay lại cài đặt chung

    .form-card
      form(action=`/${pathAdmin}/setting/website-info?_method=PATCH` method="POST" enctype="multipart/form-data")
        
        //- ========================================================
        //- PHẦN 1: THÔNG TIN DOANH NGHIỆP & NHẬN DIỆN THƯƠNG HIỆU
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-building
          h3 1. Thông Tin Doanh Nghiệp & Nhận Diện Thương Hiệu
        
        .form-row-2
          .form-group
            label Tên Website / Thương hiệu <span class="text-danger">*</span>
            input.form-control(type="text" name="websiteName" value=(settingWebsiteInfo ? settingWebsiteInfo.websiteName : "") placeholder="VD: TitiSport" required)
          
          .form-group
            label Khẩu hiệu / Slogan thương hiệu
            input.form-control(type="text" name="slogan" value=(settingWebsiteInfo ? settingWebsiteInfo.slogan : "") placeholder="VD: Bứt Phá Mọi Giới Hạn Thể Thao")

        .form-row-2
          .form-group
            label Hotline hỗ trợ 24/7
            input.form-control(type="text" name="hotline" value=(settingWebsiteInfo ? settingWebsiteInfo.hotline : "") placeholder="VD: 1900 6868")
          
          .form-group
            label Số điện thoại liên hệ
            input.form-control(type="text" name="phone" value=(settingWebsiteInfo ? settingWebsiteInfo.phone : "") placeholder="VD: 0987 654 321")

        .form-row-2
          .form-group
            label Email liên hệ / Chăm sóc khách hàng
            input.form-control(type="email" name="email" value=(settingWebsiteInfo ? settingWebsiteInfo.email : "") placeholder="VD: contact@titisport.vn")
          
          .form-group
            label Giờ làm việc / Mở cửa
            input.form-control(type="text" name="workingHours" value=(settingWebsiteInfo ? settingWebsiteInfo.workingHours : "") placeholder="VD: 08:00 - 22:00 (Tất cả các ngày)")

        .form-group
          label Địa chỉ cửa hàng / Trụ sở chính
          input.form-control(type="text" name="address" value=(settingWebsiteInfo ? settingWebsiteInfo.address : "") placeholder="VD: 123 Đường Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh")
            
        .form-row-2.upload-row
          .form-group
            label Logo Website
            .upload-image-wrapper(upload-image-wrapper)
              input#logo-upload.hidden-input(upload-image-input type="file" name="logo" accept="image/*")
              label.upload-box(for="logo-upload" upload-image-label class=(settingWebsiteInfo && settingWebsiteInfo.logo ? "hidden" : ""))
                i.fa-solid.fa-plus
              .image-preview-container(upload-image-preview-container class=(settingWebsiteInfo && settingWebsiteInfo.logo ? "" : "hidden"))
                img(upload-image-preview src=(settingWebsiteInfo && settingWebsiteInfo.logo ? settingWebsiteInfo.logo : "") alt="Preview Logo")
                button.btn-remove-image(type="button" button-remove-image title="Xóa ảnh")
                  i.fa-solid.fa-xmark
                  
          .form-group
            label Favicon (Icon tab trình duyệt)
            .upload-image-wrapper(upload-image-wrapper)
              input#favicon-upload.hidden-input(upload-image-input type="file" name="favicon" accept="image/*")
              label.upload-box(for="favicon-upload" upload-image-label class=(settingWebsiteInfo && settingWebsiteInfo.favicon ? "hidden" : ""))
                i.fa-solid.fa-plus
              .image-preview-container(upload-image-preview-container class=(settingWebsiteInfo && settingWebsiteInfo.favicon ? "" : "hidden"))
                img(upload-image-preview src=(settingWebsiteInfo && settingWebsiteInfo.favicon ? settingWebsiteInfo.favicon : "") alt="Preview Favicon")
                button.btn-remove-image(type="button" button-remove-image title="Xóa ảnh")
                  i.fa-solid.fa-xmark

        hr.section-divider

        //- ========================================================
        //- PHẦN 2: HERO BANNER TRANG CHỦ (ĐẦU TRANG)
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-image
          h3 2. Cấu Hình Hero Banner Trang Chủ (Vị trí đầu trang)

        .form-row-2
          .form-group
            label Huy hiệu nổi bật (Badge)
            input.form-control(type="text" name="heroBadge" value=(settingWebsiteInfo ? settingWebsiteInfo.heroBadge : "") placeholder="VD: THẾ GIỚI ĐỒ THỂ THAO CHÍNH HÃNG")
          
          .form-group
            label Tiêu đề chính Banner (Hỗ trợ thẻ &lt;br&gt; ngắt dòng)
            input.form-control(type="text" name="heroTitle" value=(settingWebsiteInfo ? settingWebsiteInfo.heroTitle : "") placeholder="VD: BỨT PHÁ<br>MỌI GIỚI HẠN")

        .form-group
          label Đoạn mô tả chi tiết Banner
          textarea.form-control(name="heroDescription" rows="2" placeholder="Trải nghiệm đẳng cấp với bộ sưu tập thể thao mới nhất...") #{settingWebsiteInfo ? settingWebsiteInfo.heroDescription : ""}

        .form-row-2
          .form-group
            label Chữ trên nút kêu gọi (CTA Button)
            input.form-control(type="text" name="heroBtnText" value=(settingWebsiteInfo ? settingWebsiteInfo.heroBtnText : "") placeholder="VD: Khám Phá Ngay")
          
          .form-group
            label Liên kết nút kêu gọi (CTA Link)
            input.form-control(type="text" name="heroBtnLink" value=(settingWebsiteInfo ? settingWebsiteInfo.heroBtnLink : "") placeholder="VD: /product")

        .form-group.upload-row
          label Ảnh nền Banner chính (Khuyến nghị: 1920x800px)
          .upload-image-wrapper(upload-image-wrapper)
            input#hero-upload.hidden-input(upload-image-input type="file" name="heroImage" accept="image/*")
            label.upload-box(for="hero-upload" upload-image-label class=(settingWebsiteInfo && settingWebsiteInfo.heroImage ? "hidden" : ""))
              i.fa-solid.fa-plus
            .image-preview-container(upload-image-preview-container class=(settingWebsiteInfo && settingWebsiteInfo.heroImage ? "" : "hidden"))
              img(upload-image-preview src=(settingWebsiteInfo && settingWebsiteInfo.heroImage ? settingWebsiteInfo.heroImage : "") alt="Preview Banner")
              button.btn-remove-image(type="button" button-remove-image title="Xóa ảnh")
                i.fa-solid.fa-xmark

        hr.section-divider

        //- ========================================================
        //- PHẦN 3: 4 CAM KẾT & LỢI THẾ THƯƠNG HIỆU (TRUST FEATURES)
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-shield-halved
          h3 3. 4 Cam Kết & Lợi Thế Thương Hiệu (Trust Features Trên Trang Chủ)

        .trust-badges-config-grid(style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;")
          .trust-badge-card(style="background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0;")
            h4(style="font-size: 14px; margin-bottom: 12px; color: #0f172a;")
              i.fa-solid.fa-truck-fast(style="color: #e11d48; margin-right: 6px;")
              | Cam kết 1: Vận chuyển
            .form-group
              label Tiêu đề:
              input.form-control(type="text" name="trustBadge1_title" value=(settingWebsiteInfo ? settingWebsiteInfo.trustBadge1_title : "") placeholder="VD: Giao Hàng Hỏa Tốc 2H")
            .form-group
              label Mô tả:
              textarea.form-control(name="trustBadge1_desc" rows="2" placeholder="VD: Nhận hàng ngay trong ngày, hỗ trợ kiểm hàng trước khi trả tiền...") #{settingWebsiteInfo ? settingWebsiteInfo.trustBadge1_desc : ""}

          .trust-badge-card(style="background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0;")
            h4(style="font-size: 14px; margin-bottom: 12px; color: #0f172a;")
              i.fa-solid.fa-certificate(style="color: #2563eb; margin-right: 6px;")
              | Cam kết 2: Nguồn gốc xuất xứ
            .form-group
              label Tiêu đề:
              input.form-control(type="text" name="trustBadge2_title" value=(settingWebsiteInfo ? settingWebsiteInfo.trustBadge2_title : "") placeholder="VD: 100% Hàng Chính Hãng")
            .form-group
              label Mô tả:
              textarea.form-control(name="trustBadge2_desc" rows="2" placeholder="VD: Cam kết chất lượng quốc tế, đền bù gấp 10 lần nếu phát hiện hàng nhái...") #{settingWebsiteInfo ? settingWebsiteInfo.trustBadge2_desc : ""}

          .trust-badge-card(style="background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0;")
            h4(style="font-size: 14px; margin-bottom: 12px; color: #0f172a;")
              i.fa-solid.fa-rotate-left(style="color: #16a34a; margin-right: 6px;")
              | Cam kết 3: Đổi trả linh hoạt
            .form-group
              label Tiêu đề:
              input.form-control(type="text" name="trustBadge3_title" value=(settingWebsiteInfo ? settingWebsiteInfo.trustBadge3_title : "") placeholder="VD: Đổi Trả Miễn Phí 30 Ngày")
            .form-group
              label Mô tả:
              textarea.form-control(name="trustBadge3_desc" rows="2" placeholder="VD: Hỗ trợ đổi size linh hoạt tận nơi, thủ tục đơn giản trong 1 phút...") #{settingWebsiteInfo ? settingWebsiteInfo.trustBadge3_desc : ""}

          .trust-badge-card(style="background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0;")
            h4(style="font-size: 14px; margin-bottom: 12px; color: #0f172a;")
              i.fa-solid.fa-headset(style="color: #d97706; margin-right: 6px;")
              | Cam kết 4: Tư vấn & Chăm sóc
            .form-group
              label Tiêu đề:
              input.form-control(type="text" name="trustBadge4_title" value=(settingWebsiteInfo ? settingWebsiteInfo.trustBadge4_title : "") placeholder="VD: Tư Vấn Chuyên Nghiệp 24/7")
            .form-group
              label Mô tả:
              textarea.form-control(name="trustBadge4_desc" rows="2" placeholder="VD: Đội ngũ am hiểu sâu về dụng cụ và giày thể thao chuyên dụng...") #{settingWebsiteInfo ? settingWebsiteInfo.trustBadge4_desc : ""}

        hr.section-divider

        //- ========================================================
        //- PHẦN 4: BANNER QUẢNG CÁO KHUYẾN MÃI (GIỮA TRANG)
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-bullhorn
          h3 4. Banner Quảng Cáo Khuyến Mãi (Vị trí giữa trang chủ)

        .form-row-2
          .form-group
            label Tiêu đề Banner Khuyến Mãi
            input.form-control(type="text" name="promoBannerTitle" value=(settingWebsiteInfo ? settingWebsiteInfo.promoBannerTitle : "") placeholder="VD: ĐẠI TIỆC SALE MÙA GIẢI - GIẢM ĐẾN 50%")
          
          .form-group
            label Phụ đề / Mô tả ngắn
            input.form-control(type="text" name="promoBannerSubtitle" value=(settingWebsiteInfo ? settingWebsiteInfo.promoBannerSubtitle : "") placeholder="VD: Áp dụng cho toàn bộ giày đá bóng và áo đấu CLB")

        .form-group
          label Liên kết Banner Khuyến Mãi
          input.form-control(type="text" name="promoBannerLink" value=(settingWebsiteInfo ? settingWebsiteInfo.promoBannerLink : "") placeholder="VD: /product?featured=1")

        .form-group.upload-row
          label Ảnh Banner Khuyến Mãi (Khuyến nghị: 1200x400px)
          .upload-image-wrapper(upload-image-wrapper)
            input#promo-upload.hidden-input(upload-image-input type="file" name="promoBannerImage" accept="image/*")
            label.upload-box(for="promo-upload" upload-image-label class=(settingWebsiteInfo && settingWebsiteInfo.promoBannerImage ? "hidden" : ""))
              i.fa-solid.fa-plus
            .image-preview-container(upload-image-preview-container class=(settingWebsiteInfo && settingWebsiteInfo.promoBannerImage ? "" : "hidden"))
              img(upload-image-preview src=(settingWebsiteInfo && settingWebsiteInfo.promoBannerImage ? settingWebsiteInfo.promoBannerImage : "") alt="Preview Promo Banner")
              button.btn-remove-image(type="button" button-remove-image title="Xóa ảnh")
                i.fa-solid.fa-xmark

        hr.section-divider

        //- ========================================================
        //- PHẦN 5: MẠNG XÃ HỘI & KÊNH LIÊN HỆ NỔI
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-share-nodes
          h3 5. Mạng Xã Hội & Kênh Liên Hệ Nổi (Floating Box)

        .form-row-2
          .form-group
            label Facebook Fanpage URL
            input.form-control(type="url" name="facebook" value=(settingWebsiteInfo ? settingWebsiteInfo.facebook : "") placeholder="https://facebook.com/titisport")
          
          .form-group
            label Instagram URL
            input.form-control(type="url" name="instagram" value=(settingWebsiteInfo ? settingWebsiteInfo.instagram : "") placeholder="https://instagram.com/titisport")

        .form-row-2
          .form-group
            label TikTok Channel URL
            input.form-control(type="url" name="tiktok" value=(settingWebsiteInfo ? settingWebsiteInfo.tiktok : "") placeholder="https://tiktok.com/@titisport")
          
          .form-group
            label YouTube Channel URL
            input.form-control(type="url" name="youtube" value=(settingWebsiteInfo ? settingWebsiteInfo.youtube : "") placeholder="https://youtube.com/@titisport")

        .form-group
          label Zalo OA / Số Zalo hỗ trợ
          input.form-control(type="text" name="zalo" value=(settingWebsiteInfo ? settingWebsiteInfo.zalo : "") placeholder="https://zalo.me/0987654321")

        hr.section-divider

        //- ========================================================
        //- PHẦN 6: CHÂN TRANG (FOOTER) & BẢN QUYỀN
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-shoe-prints
          h3 6. Thông Tin Chân Trang (Footer) & Pháp Lý

        .form-group
          label Giới thiệu ngắn về cửa hàng (Hiển thị chân trang)
          textarea.form-control(name="aboutShort" rows="2" placeholder="VD: Điểm đến số 1 cho những người đam mê thể thao. Cam kết hàng chính hãng 100%, chất lượng đỉnh cao...") #{settingWebsiteInfo ? settingWebsiteInfo.aboutShort : ""}

        .form-row-2
          .form-group
            label Dòng chữ bản quyền (Copyright)
            input.form-control(type="text" name="copyright" value=(settingWebsiteInfo ? settingWebsiteInfo.copyright : "") placeholder="VD: © 2026 TitiSport. All rights reserved. Designed for athletes.")
          
          .form-group
            label Giấy phép kinh doanh / Mã số thuế
            input.form-control(type="text" name="businessLicense" value=(settingWebsiteInfo ? settingWebsiteInfo.businessLicense : "") placeholder="VD: GPKD số 0102030405 do Sở KH&ĐT cấp ngày 01/01/2026")

        hr.section-divider

        //- ========================================================
        //- PHẦN 7: CẤU HÌNH SEO META & BẢN ĐỒ
        //- ========================================================
        .setting-section-header
          i.fa-solid.fa-magnifying-glass-chart
          h3 7. Cấu Hình SEO Meta & Bản Đồ Google Maps

        .form-group
          label Tiêu đề trang mặc định (Meta Title)
          input.form-control(type="text" name="metaTitle" value=(settingWebsiteInfo ? settingWebsiteInfo.metaTitle : "") placeholder="VD: TitiSport - Hệ Thống Đồ Thể Thao Chính Hãng Hàng Đầu")

        .form-group
          label Mô tả trang mặc định (Meta Description)
          textarea.form-control(name="metaDescription" rows="2" placeholder="VD: Mua sắm dụng cụ, giày đá bóng, áo đấu chính hãng tại TitiSport. Giao hàng hỏa tốc 2H, cam kết chính hãng 100%...") #{settingWebsiteInfo ? settingWebsiteInfo.metaDescription : ""}

        .form-group
          label Từ khóa SEO (Meta Keywords)
          input.form-control(type="text" name="metaKeywords" value=(settingWebsiteInfo ? settingWebsiteInfo.metaKeywords : "") placeholder="VD: do the thao, giay da bong, ao dau, titisport, bong da")

        .form-group
          label Mã nhúng Bản đồ Google Maps (iframe HTML)
          textarea.form-control(name="mapIframe" rows="3" placeholder="Dán thẻ <iframe src='https://www.google.com/maps/embed...'></iframe> tại đây") #{settingWebsiteInfo ? settingWebsiteInfo.mapIframe : ""}

        //- ========================================================
        //- NÚT SUBMIT LƯU THAY ĐỔI
        //- ========================================================
        if(role && role.permissions && role.permissions.includes("setting_edit"))
          .form-actions-stacked(style="margin-top: 36px; text-align: center;")
            button.btn-submit.btn-submit-large(type="submit" style="padding: 14px 40px; font-size: 16px; font-weight: 700; border-radius: 50px;") 
              i.fa-solid.fa-floppy-disk(style="margin-right: 8px;")
              |  LƯU TOÀN BỘ CẤU HÌNH WEBSITE
  else
    .no-access-wrapper
      .no-access-card
        .no-access-icon
          i.fa-solid.fa-lock

        h2.no-access-title Truy cập bị từ chối

        p.no-access-desc
          | Bạn không có quyền truy cập vào trang này.
          br
          | Vui lòng liên hệ quản trị viên để được cấp quyền phù hợp.