mixin productItem(item) 
  .flash-product-card
    button.btn-wishlist-toggle(
      type="button"
      data-id=(item.id || item._id)
      data-title=item.title
      data-slug=item.slug
      data-price=(item.priceNew || item.price)
      data-price-old=item.price
      data-thumbnail=(item.thumbnail || (item.images && item.images[0]) || "")
      title="Yêu thích sản phẩm"
      aria-label="Yêu thích"
    )
      i.fa-regular.fa-heart

    button.btn-compare-toggle(
      type="button"
      data-id=(item.id || item._id)
      data-title=item.title
      data-slug=item.slug
      data-price=(item.priceNew || item.price)
      data-price-old=item.price
      data-thumbnail=(item.thumbnail || (item.images && item.images[0]) || "")
      data-brand=(item.brand || "CHÍNH HÃNG")
      title="So sánh sản phẩm"
      aria-label="So sánh"
    )
      i.fa-solid.fa-code-compare

    a.card-link-wrapper(href=`/product/detail/${item.slug}`)
      .flash-product-card__img-wrap
        .card-badges-stack
          if item.discountPercentage > 0
            span.badge.badge-pink -#{item.discountPercentage}%
          if item.featured == "1"
            span.badge.badge-orange HOT
          else if item.isNew == true
            span.badge.badge-dark MỚI
          
        img(
          src=(item.thumbnail || (item.images && item.images[0]) || "https://placehold.co/400x400/f8fafc/94a3b8?text=TITISPORT")
          alt=item.title
          loading="lazy"
          onerror="this.onerror=null; this.src='https://placehold.co/400x400/f8fafc/94a3b8?text=TITISPORT'"
        )
        
      span.flash-product-card__brand #{item.brand || 'CHÍNH HÃNG'}
      h3.flash-product-card__title(title=item.title) #{item.title}

    .flash-product-card__rating
      - var rating = item.ratingStars || 5
      - var fullStars = Math.floor(rating)
      - var hasHalfStar = rating % 1 !== 0
      - var emptyStars = 5 - Math.ceil(rating)
      
      .stars-group
        - for (let i = 0; i < fullStars; i++)
          i.fa-solid.fa-star
        if (hasHalfStar)
          i.fa-solid.fa-star-half-stroke
        - for (let i = 0; i < emptyStars; i++)
          i.fa-regular.fa-star
      span.rating-score (#{rating}.0)

    .flash-product-card__bottom
      .flash-product-card__price
        if (item.priceNew && item.priceNew < item.price)
          span.old-price #{item.price.toLocaleString('vi-VN')}đ
          span.new-price #{item.priceNew.toLocaleString('vi-VN')}đ
        else
          span.new-price #{(item.price || 0).toLocaleString('vi-VN')}đ
      a.btn-cart(href=`/product/detail/${item.slug}` title="Xem chi tiết")
        i.fa-solid.fa-arrow-right