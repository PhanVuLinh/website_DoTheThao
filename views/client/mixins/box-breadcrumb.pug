mixin box-breadcrumb(breadcrumb) 
  - const bList = Array.isArray(breadcrumb) ? breadcrumb : (breadcrumb && breadcrumb.list ? breadcrumb.list : [])
  - const bTitle = (breadcrumb && breadcrumb.title) ? breadcrumb.title : (bList.length > 0 ? bList[bList.length - 1].title : '')
  if bList.length > 0
    .box-breadcrumb
      .inner-content
        .container
          h1.inner-title #{bTitle}
          .inner-list
            each item, index in bList
              if index === bList.length - 1
                a.active(href=item.link) #{item.title}
              else
                a(href=item.link) #{item.title}
                span.divider
                  i.fa-solid.fa-angles-right