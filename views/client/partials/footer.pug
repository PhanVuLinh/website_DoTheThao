footer.footer
  //- 1. KHỐI ĐĂNG KÝ NHẬN BẢN TIN ƯU ĐÃI (NEWSLETTER BANNER)
  if settingWebsiteInfo && settingWebsiteInfo.newsletterActive !== false
    .footer__container
      .footer__newsletter
        .newsletter-info
          h3 #{settingWebsiteInfo.newsletterTitle || "Đừng Bỏ Lỡ Ưu Đãi Độc Quyền"}
          p #{settingWebsiteInfo.newsletterSubTitle || ("Đăng ký để nhận thông tin ưu đãi mới nhất từ " + (settingWebsiteInfo.websiteName || "TitiSport"))}
        form.newsletter-form(action="/contact/create" method="POST")
          input(name="email" placeholder="Nhập địa chỉ email của bạn..." type="email" required)
          button(type="submit")
            span #{settingWebsiteInfo.newsletterBtnText || "Đăng Ký"}
            i.fa-regular.fa-paper-plane.ms-2

  //- 2. KHU VỰC NỘI DUNG CHÍNH CHÂN TRANG (MAIN CONTENT)
  .footer__container
    .footer__main
      //- CỘT 1: THƯƠNG HIỆU & GIỚI THIỆU & MẠNG XÃ HỘI
      .footer__col.brand-col
        a.logo(href="/")
          if settingWebsiteInfo && settingWebsiteInfo.logo
            img(src=settingWebsiteInfo.logo alt=(settingWebsiteInfo.websiteName || "Logo"))
          else
            span.footer-logo-fallback #{settingWebsiteInfo && settingWebsiteInfo.websiteName ? settingWebsiteInfo.websiteName : "TITISPORT"}
        
        p.brand-about #{settingWebsiteInfo && settingWebsiteInfo.aboutShort ? settingWebsiteInfo.aboutShort : (settingWebsiteInfo && settingWebsiteInfo.slogan ? settingWebsiteInfo.slogan : "Điểm đến tin cậy cho những người đam mê thể thao. Cam kết hàng chính hãng 100%, chất lượng đỉnh cao, dịch vụ tận tâm.")}
        
        //- Cam kết chất lượng
        .footer-commitments
          .commit-item
            i.fa-solid.fa-shield-halved
            span 100% Sản phẩm chính hãng
          .commit-item
            i.fa-solid.fa-rotate-left
            span Đổi mới 7 ngày nếu lỗi
          .commit-item
            i.fa-solid.fa-truck-fast
            span Giao hàng hỏa tốc toàn quốc

        //- Mạng xã hội kết nối
        .footer__social
          if settingWebsiteInfo && settingWebsiteInfo.facebook
            a(href=settingWebsiteInfo.facebook target="_blank" rel="noopener noreferrer" title="Facebook"): i.fa-brands.fa-facebook-f
          if settingWebsiteInfo && settingWebsiteInfo.instagram
            a(href=settingWebsiteInfo.instagram target="_blank" rel="noopener noreferrer" title="Instagram"): i.fa-brands.fa-instagram
          if settingWebsiteInfo && settingWebsiteInfo.tiktok
            a(href=settingWebsiteInfo.tiktok target="_blank" rel="noopener noreferrer" title="TikTok"): i.fa-brands.fa-tiktok
          if settingWebsiteInfo && settingWebsiteInfo.youtube
            a(href=settingWebsiteInfo.youtube target="_blank" rel="noopener noreferrer" title="YouTube"): i.fa-brands.fa-youtube
          if settingWebsiteInfo && settingWebsiteInfo.zalo
            a(href=settingWebsiteInfo.zalo target="_blank" rel="noopener noreferrer" title="Zalo"): i.fa-solid.fa-comment-dots

      //- CÁC CỘT LIÊN KẾT ĐỘNG (ADMIN QUẢN LÝ THÊM/SỬA/XÓA)
      if settingWebsiteInfo && settingWebsiteInfo.footerColumns && settingWebsiteInfo.footerColumns.length > 0
        each col in settingWebsiteInfo.footerColumns
          .footer__col.nav-col
            h4 #{col.title}
            ul.footer__links
              if col.links && col.links.length > 0
                each link in col.links
                  li
                    a(href=link.url)
                      i.fa-solid.fa-chevron-right.link-arrow
                      span #{link.text}

      //- CỘT THÔNG TIN LIÊN HỆ & SHOWROOM
      .footer__col.contact-col
        h4 Thông Tin Liên Hệ
        ul.footer__contact
          if settingWebsiteInfo && settingWebsiteInfo.address
            li
              .icon-wrapper: i.fa-solid.fa-location-dot
              .contact-detail
                strong Trụ sở chính:
                span #{settingWebsiteInfo.address}
          if settingWebsiteInfo && (settingWebsiteInfo.hotline || settingWebsiteInfo.phone)
            li
              .icon-wrapper: i.fa-solid.fa-phone
              .contact-detail
                strong Hotline tư vấn:
                a.hotline-link(href=`tel:${settingWebsiteInfo.hotline || settingWebsiteInfo.phone}`) #{settingWebsiteInfo.hotline || settingWebsiteInfo.phone}
          if settingWebsiteInfo && settingWebsiteInfo.email
            li
              .icon-wrapper: i.fa-solid.fa-envelope
              .contact-detail
                strong Email:
                span #{settingWebsiteInfo.email}
          if settingWebsiteInfo && settingWebsiteInfo.workingHours
            li
              .icon-wrapper: i.fa-regular.fa-clock
              .contact-detail
                strong Giờ mở cửa:
                span #{settingWebsiteInfo.workingHours}

        //- Danh sách Showroom / Chi nhánh cửa hàng (Admin quản lý động)
        if settingWebsiteInfo && settingWebsiteInfo.footerBranches && settingWebsiteInfo.footerBranches.length > 0
          .footer-branches-block
            .branches-header
              i.fa-solid.fa-store.text-danger.me-1
              strong Hệ Thống Showroom
            .branches-scroll
              each branch in settingWebsiteInfo.footerBranches
                .branch-row
                  .branch-dot
                  .branch-info
                    span.branch-title #{branch.name}
                    p.branch-addr #{branch.address}
                    if branch.phone
                      span.branch-tel
                        i.fa-solid.fa-phone.me-1
                        | #{branch.phone}

      //- CỘT BẢN ĐỒ CHỈ ĐƯỜNG GOOGLE MAPS (HIỂN THỊ TRỰC TIẾP TẠI CHÂN TRANG)
      if settingWebsiteInfo && settingWebsiteInfo.footerMapActive !== false
        .footer__col.map-col
          h4 #{settingWebsiteInfo.footerMapTitle || "Vị Trí Cửa Hàng"}
          p.map-subtitle #{settingWebsiteInfo.footerMapSubTitle || "Ghé thăm trải nghiệm sản phẩm trực tiếp"}
          
          .footer-map-container
            .footer-map-frame
              if settingWebsiteInfo.footerMapIframe || settingWebsiteInfo.mapIframe
                != (settingWebsiteInfo.footerMapIframe || settingWebsiteInfo.mapIframe)
              else
                iframe(
                  src=`https://www.google.com/maps?q=${encodeURIComponent(settingWebsiteInfo.address || "Vĩnh Lộc, Hồ Chí Minh")}&output=embed`
                  loading="lazy"
                  allowfullscreen=""
                  referrerpolicy="no-referrer-when-downgrade"
                )
            
            .footer-map-bar
              .map-address-pill(title=(settingWebsiteInfo.address || "TitiSport Store"))
                i.fa-solid.fa-location-dot.text-danger.me-1
                span #{settingWebsiteInfo.address || "Xem trên bản đồ"}
              a.btn-map-guide(
                href=(settingWebsiteInfo.footerMapDirectionUrl || `https://maps.google.com/?q=${encodeURIComponent(settingWebsiteInfo.address || "TitiSport Store")}`)
                target="_blank"
                rel="noopener noreferrer"
                title="Mở Google Maps dẫn đường"
              )
                i.fa-solid.fa-diamond-turn-right.me-1
                | Chỉ đường

  //- 3. DÒNG CHÂN TRANG DƯỚI CÙNG (BOTTOM BAR)
  .footer__bottom
    .footer__container
      .footer__bottom-inner
        .bottom-left
          p.footer-copyright #{settingWebsiteInfo && settingWebsiteInfo.copyright ? settingWebsiteInfo.copyright : `© ${new Date().getFullYear()} ${settingWebsiteInfo && settingWebsiteInfo.websiteName ? settingWebsiteInfo.websiteName : "TitiSport"}. Bản quyền thuộc về TitiSport Store.`}
          if settingWebsiteInfo && settingWebsiteInfo.businessLicense
            p.footer-business-license #{settingWebsiteInfo.businessLicense}
        
        .bottom-right
          //- Phương thức thanh toán
          if settingWebsiteInfo && settingWebsiteInfo.footerPaymentActive !== false
            .footer-payment-methods
              span.payment-title Thanh toán an toàn:
              .payment-badges
                span.badge-pay(title="Thanh toán khi nhận hàng (COD)"): i.fa-solid.fa-money-bill-wave
                span.badge-pay(title="Chuyển khoản VietQR"): i.fa-solid.fa-qrcode
                span.badge-pay(title="Thẻ ATM / Visa / Mastercard"): i.fa-solid.fa-credit-card
                span.badge-pay(title="Ví VNPay QR"): strong VNPAY
                span.badge-pay(title="Ví ZaloPay"): strong ZaloPay

          //- Huy hiệu chứng nhận
          if settingWebsiteInfo && settingWebsiteInfo.footerCertificationsActive !== false
            .footer-certifications
              span.badge-cert(title="Đã thông báo Bộ Công Thương")
                i.fa-solid.fa-certificate.text-danger.me-1
                | Đã Thông Báo BCT
              span.badge-cert(title="Chứng nhận an toàn SSL 256-bit")
                i.fa-solid.fa-lock.text-success.me-1
                | SSL Secure