.top-bar
  .top-bar__inner
    if(settingWebsiteInfo && (settingWebsiteInfo.hotline || settingWebsiteInfo.phone))
      .top-bar__item
        i.fa-solid.fa-phone
        | #{settingWebsiteInfo.hotline || settingWebsiteInfo.phone}

    if(settingWebsiteInfo && settingWebsiteInfo.email)
      .top-bar__item
        i.fa-solid.fa-envelope
        | #{settingWebsiteInfo.email}
  
    if(settingWebsiteInfo && settingWebsiteInfo.address)
      .top-bar__item
        i.fa-solid.fa-location-dot
        | #{settingWebsiteInfo.address}

    if(settingWebsiteInfo && settingWebsiteInfo.workingHours)
      .top-bar__item
        i.fa-regular.fa-clock
        | #{settingWebsiteInfo.workingHours}

.navbar-floating-wrapper#siteNavbarWrapper
  nav.navbar#siteNavbar
    .navbar__inner
      button.mobile-toggle-btn
        i.fa-solid.fa-bars

      a.logo(href="/")
        if settingWebsiteInfo && settingWebsiteInfo.logo
          img.logo__img(src=settingWebsiteInfo.logo, alt=(settingWebsiteInfo.websiteName || "Logo"))
        else
          span.logo__text-fallback #{settingWebsiteInfo && settingWebsiteInfo.websiteName ? settingWebsiteInfo.websiteName : "SportStore"}

      .mobile-overlay

      .nav-menu-wrapper
        .mobile-drawer-header
          if (user)
            .mobile-user-card
              .mobile-user-avatar
                i.fa-solid.fa-circle-user
              .mobile-user-info
                span.mobile-user-greeting Xin chào,
                strong.mobile-user-name #{user.fullName}
          else
            .mobile-user-guest
              .mobile-guest-avatar
                i.fa-regular.fa-user
              .mobile-guest-info
                strong Tài khoản
                span Đăng nhập để nhận ưu đãi
              a.btn-mobile-login(href="/auth/login") Đăng nhập

          button.mobile-close-btn(type="button" aria-label="Đóng menu")
            i.fa-solid.fa-xmark

        .mobile-quick-bar
          a.mobile-quick-btn(href="/wishlist" title="Yêu thích")
            i.fa-regular.fa-heart
            span Yêu thích
            span.drawer-badge.badge-pink#wishlist-drawer-counter(style="display: none;") 0
          a.mobile-quick-btn(href="/compare" title="So sánh")
            i.fa-solid.fa-code-compare
            span So sánh
            span.drawer-badge.badge-blue#compare-drawer-counter(style="display: none;") 0
          a.mobile-quick-btn(href="/cart" title="Giỏ hàng")
            i.fa-solid.fa-cart-shopping
            span Giỏ hàng
            if (miniCart > 0)
              span.drawer-badge.badge-red #{miniCart}

        .mobile-drawer-body
          .mobile-menu-section-title DANH MỤC SẢN PHẨM
          ul.nav-links
            li
              a(href="/") Trang Chủ
              
            each item in categoryList
              li
                a(href=`/category/${item.slug}`) #{item.title}
                  if(item.children && item.children.length > 0)
                    i.fa-solid.fa-chevron-down.arrow
                    
                if(item.children && item.children.length > 0)
                  .dropdown
                    each itemChild in item.children 
                      a(href=`/category/${itemChild.slug}`) #{itemChild.title}
                  
            li
              a(href="/article") Tin Tức
              
            li
              a(href="/contact") Liên Hệ

          .mobile-menu-section-title CÔNG NGHỆ & TƯ VẤN THỂ THAO
          ul.mobile-user-nav-list
            if (settingWebsiteInfo && settingWebsiteInfo.aiLabActive !== false)
              li
                a.ai-mobile-menu-link#btnMobileOpenAiLab(href="#ai-sport-lab")
                  i.fa-solid.fa-wand-magic-sparkles
                  span #{settingWebsiteInfo && settingWebsiteInfo.aiLabTitle ? settingWebsiteInfo.aiLabTitle : "AI Tư Vấn Vợt & Giày"}
                  span.ai-menu-badge AI PRO
            li
              a.theme-mobile-menu-link#btnMobileToggleTheme(href="#toggle-theme")
                i.fa-solid.fa-circle-half-stroke
                span Chế độ Sân Đấu Pro Arena
                span.theme-status-text#mobileThemeStatus TẮT

          if (user)
            .mobile-menu-section-title TÀI KHOẢN CỦA BẠN
            ul.mobile-user-nav-list
              li
                a(href="/user/profile")
                  i.fa-regular.fa-id-card
                  span Thông tin tài khoản
              li
                a(href="/user/order-history")
                  i.fa-solid.fa-box-open
                  span Đơn hàng của tôi
              li
                a.text-danger(href="/auth/logout")
                  i.fa-solid.fa-arrow-right-from-bracket
                  span Đăng xuất


      .nav-actions
        if (settingWebsiteInfo && settingWebsiteInfo.aiLabActive !== false)
          button.action-btn.ai-lab-header-btn#btnHeaderOpenAiLab(type="button" title=(settingWebsiteInfo && settingWebsiteInfo.aiLabTitle ? settingWebsiteInfo.aiLabTitle : "AI Tư Vấn Vợt & Giày Thể Thao") aria-label="Mở AI Lab")
            i.fa-solid.fa-wand-magic-sparkles
            span.action-badge.badge-ai AI

        button.action-btn.theme-toggle-btn#btnThemeToggle(type="button" title="Chế độ Sân Đấu Pro Arena / Sáng" aria-label="Đổi giao diện")
          i.fa-solid.fa-moon

        button.action-btn.search-toggle-btn(type="button" title="Tìm kiếm sản phẩm" aria-label="Mở tìm kiếm")
          i.fa-solid.fa-magnifying-glass

        a(href="/wishlist" title="Danh sách yêu thích").action-btn.wishlist-action-btn
          i.fa-regular.fa-heart
          span.action-badge.badge-pink#wishlist-counter(style="display: none;") 0

        a(href="/compare" title="So sánh sản phẩm").action-btn.compare-action-btn
          i.fa-solid.fa-code-compare
          span.action-badge.badge-blue#compare-counter(style="display: none;") 0

        a(href="/cart" title="Giỏ hàng").action-btn.cart-action-btn
          i.fa-solid.fa-cart-shopping
          if (miniCart > 0)
            span.action-badge.badge-red #{miniCart}

        if (user) 
          .user-profile-menu
            button.action-btn.user-action-btn.user-logged-btn(type="button" title=user.fullName aria-label="Tài khoản")
              i.fa-solid.fa-circle-user
            .user-dropdown
              .user-dropdown-header
                span.user-greeting Xin chào,
                strong #{user.fullName}
              a.user-dropdown-item(href="/user/profile") 
                i.fa-regular.fa-id-card
                | Thông tin tài khoản
              a.user-dropdown-item(href="/user/order-history") 
                i.fa-solid.fa-box-open
                | Đơn hàng của tôi
              a.user-dropdown-item(href="/wishlist") 
                i.fa-regular.fa-heart
                | Danh sách yêu thích
              hr
              a.user-dropdown-item.text-danger(href="/auth/logout")
                i.fa-solid.fa-arrow-right-from-bracket
                | Đăng xuất
        else
          a.action-btn.user-action-btn(href="/auth/login" title="Đăng nhập tài khoản" aria-label="Đăng nhập")
            i.fa-regular.fa-user

    //- EXPANDABLE SEARCH DRAWER (Lúc dùng / khi click icon tìm kiếm)
    .header-search-drawer#headerSearchDrawer
      .search-drawer__content
        form.search-drawer__form(action="/search" method="GET")
          i.fa-solid.fa-magnifying-glass.drawer-search-icon
          input.drawer-search-input#headerSearchInput(type="text" name="keyword" placeholder="Tìm kiếm giày đá bóng, áo đấu, phụ kiện..." value=(keyword || "") autocomplete="off")
          button.drawer-search-clear#headerSearchClear(type="button" aria-label="Xóa từ khóa" style="display: none;")
            i.fa-solid.fa-circle-xmark
          button.drawer-search-submit(type="submit")
            i.fa-solid.fa-magnifying-glass
            span Tìm kiếm
          button.drawer-search-close#headerSearchClose(type="button" aria-label="Đóng tìm kiếm")
            i.fa-solid.fa-xmark
        .search-drawer__suggestions#defaultSuggestions
          span.sugg-label Gợi ý:
          a.sugg-tag(href="/search?keyword=Puma") Puma King
          a.sugg-tag(href="/search?keyword=Nike") Nike Phantom
          a.sugg-tag(href="/search?keyword=Giày") Giày đá bóng
          a.sugg-tag(href="/search?keyword=Áo") Áo thi đấu
          a.sugg-tag(href="/search?keyword=Bóng") Quả bóng đá

        //- Dropdown gợi ý sản phẩm trực tiếp (Live Search Dropdown)
        .search-live-dropdown#searchLiveDropdown(style="display: none;")

.header-search-backdrop#headerSearchBackdrop