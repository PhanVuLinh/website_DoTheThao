.top-bar
  .top-bar__inner
    if(settingWebsiteInfo.phone)
      .top-bar__item
        i.fa-solid.fa-phone
        | #{settingWebsiteInfo.phone}

    if(settingWebsiteInfo.email)
      .top-bar__item
        i.fa-solid.fa-envelope
        | #{settingWebsiteInfo.email}
  
    if(settingWebsiteInfo.address)
      .top-bar__item
        i.fa-solid.fa-location-dot
        | #{settingWebsiteInfo.address}

nav.navbar
  .navbar__inner
    button.mobile-toggle-btn
      i.fa-solid.fa-bars

    a.logo(href="/")
      img.logo__img(src=settingWebsiteInfo.logo, alt=settingWebsiteInfo.websiteName)

    .mobile-overlay

    .nav-menu-wrapper
      button.mobile-close-btn
        i.fa-solid.fa-xmark
        
      ul.nav-links
        li
          a(href="/") Trang Chủ
          
        each item in categoryList
          li
            a(href=`/category/${item.slug}`) #{item.title}
              if(item.children && item.children.length > 0)
                i.fa-solid.fa-chevron-down.arrow
                
            if(item.children && item.children.length > 0)
              .dropdown
                each itemChild in item.children 
                  a(href=`/category/${itemChild.slug}`) #{itemChild.title}
              
        li
          a(href="/article") Tin Tức
          
        //- li
        //-   a(href="") Liên Hệ

    form.header-search(action="/search" method="GET")
      i.fa-solid.fa-magnifying-glass.header-search__icon
      input(type="text" name="keyword" placeholder="Tìm kiếm sản phẩm, thương hiệu..." value=(keyword || "") autocomplete="off")
      button.header-search__btn(type="submit" aria-label="Tìm kiếm")
        i.fa-solid.fa-arrow-right

    .nav-actions
      a(href="/cart" title="Giỏ hàng").action-btn.cart-action-btn
        i.fa-solid.fa-cart-shopping
        if (miniCart > 0)
          span.action-badge.badge-red #{miniCart}

      if (user) 
        .user-profile-menu
          button.user-pill-btn(type="button")
            i.fa-solid.fa-circle-user
            span.user-name #{user.fullName ? user.fullName.split(' ').slice(-1)[0] : 'Tài khoản'}
            i.fa-solid.fa-chevron-down.user-chevron
          .user-dropdown
            .user-dropdown-header
              span.user-greeting Xin chào,
              strong #{user.fullName}
            a.user-dropdown-item(href="/user/profile") 
              i.fa-regular.fa-id-card
              | Thông tin tài khoản
            a.user-dropdown-item(href="/user/order-history") 
              i.fa-solid.fa-box-open
              | Đơn hàng của tôi
            hr
            a.user-dropdown-item.text-danger(href="/auth/logout")
              i.fa-solid.fa-arrow-right-from-bracket
              | Đăng xuất
      else
        a.auth-pill-btn(href="/auth/login")
          i.fa-regular.fa-user
          span Đăng nhập