//- ====================================================================
//- FLOATING SPEED DIAL CONTACT (NÚT LIÊN HỆ NHANH NỔI GÓC TRÁI MÀN HÌNH)
//- ====================================================================
.box-contact#boxContactFloating
  ul.box-contact__list
    if settingWebsiteInfo && (settingWebsiteInfo.hotline || settingWebsiteInfo.phone)
      li.contact-item.contact-item--phone
        a(
          href=`tel:${settingWebsiteInfo.hotline || settingWebsiteInfo.phone}` 
          title=`Hotline: ${settingWebsiteInfo.hotline || settingWebsiteInfo.phone}` 
          aria-label="Gọi ngay hotline"
        )
          .icon-pulse-wave
          i.fa-solid.fa-phone
          span.contact-tooltip Hotline: #{settingWebsiteInfo.hotline || settingWebsiteInfo.phone}

    if settingWebsiteInfo && settingWebsiteInfo.zalo
      li.contact-item.contact-item--zalo
        a(
          target="_blank" 
          rel="noopener noreferrer" 
          href=settingWebsiteInfo.zalo 
          title="Tư vấn trực tiếp qua Zalo" 
          aria-label="Chat qua Zalo"
        )
          i.fa-solid.fa-comment-dots
          span.contact-tooltip Chat Zalo

    if settingWebsiteInfo && settingWebsiteInfo.facebook
      li.contact-item.contact-item--facebook
        a(
          target="_blank" 
          rel="noopener noreferrer" 
          href=settingWebsiteInfo.facebook 
          title="Nhắn tin qua Fanpage Facebook" 
          aria-label="Nhắn tin Facebook"
        )
          i.fa-brands.fa-facebook-f
          span.contact-tooltip Chat Facebook