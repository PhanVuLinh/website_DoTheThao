extends ../layouts/default.pug
include ../mixins/alert.pug

block main
  +alert-success(3000)
  .cart-page
    .container
      .success-wrapper(data-order-id=(orderDetail.id || orderDetail._id))
        .success-hero
          .success-icon-wrap
            i.fa-solid.fa-check
          h1.success-title Đặt hàng thành công!
          p.success-subtitle 
            | Cảm ơn bạn đã mua sắm tại 
            strong #{settingWebsiteInfo.websiteName}
            | . Đơn hàng của bạn đã được ghi nhận và đang được xử lý.
          .order-code-box
            span Mã đơn hàng:
            strong.highlight-text #{orderDetail.orderCode}

        //- Real-time Order Tracking Stepper
        .order-tracker-card
          .order-tracker-header
            .tracker-title
              i.fa-solid.fa-truck-fast
              span Trạng Thái Giao Hàng
          .order-stepper#orderStepper(data-status=orderDetail.status)
            .stepper-step(class=(orderDetail.status === 'initial' || orderDetail.status === 'shipping' || orderDetail.status === 'done' ? 'active current' : ''))
              .step-icon
                i.fa-solid.fa-file-invoice
              .step-label Đã tiếp nhận
              .step-time #{orderDetail.createdAtFormat}
            .stepper-line(class=(orderDetail.status === 'shipping' || orderDetail.status === 'done' ? 'active' : ''))
            .stepper-step(class=(orderDetail.status === 'shipping' ? 'active current' : (orderDetail.status === 'done' ? 'active' : '')))
              .step-icon
                i.fa-solid.fa-truck-ramp-box
              .step-label Đang vận chuyển
              .step-time= (orderDetail.status === 'shipping' || orderDetail.status === 'done') ? 'Đang trên đường giao' : 'Đang chuẩn bị hàng'
            .stepper-line(class=(orderDetail.status === 'done' ? 'active' : ''))
            .stepper-step(class=(orderDetail.status === 'done' ? 'active current' : ''))
              .step-icon
                i.fa-solid.fa-circle-check
              .step-label Giao thành công
              .step-time= orderDetail.status === 'done' ? 'Đã hoàn tất' : 'Dự kiến 2-3 ngày'

          if orderDetail.status === 'cancel'
            .order-cancel-alert
              i.fa-solid.fa-triangle-exclamation
              span Đơn hàng này đã bị hủy. Nếu có nhầm lẫn, vui lòng liên hệ bộ phận hỗ trợ khách hàng.

        .success-details-grid
          .success-card
            h3.success-card__title
              i.fa-solid.fa-location-dot
              | Thông tin giao hàng
            ul.success-info-list
              li
                span.label Tên người nhận:
                span.value #{orderDetail.fullName}
              li
                span.label Số điện thoại:
                span.value #{orderDetail.phone}
              li
                span.label Địa chỉ:
                span.value #{orderDetail.address}
              if (orderDetail.note)
                li
                  span.label Ghi chú:
                  span.value #{orderDetail.note}

          .success-card
            h3.success-card__title
              i.fa-solid.fa-wallet
              | Thông tin thanh toán
            ul.success-info-list
              li
                span.label Phương thức thanh toán:
                span.value #{orderDetail.paymentMethodName}
              li
                span.label Trạng thái thanh toán:
                span.value.status-badge.pending #{orderDetail.paymentStatusName}
              li
                span.label Trạng thái đơn hàng:
                span.value #{orderDetail.statusName}
              li
                span.label Ngày đặt:
                span.value #{orderDetail.createdAtFormat}
              li
                span.label Tạm tính:
                span.value #{orderDetail.subtotal.toLocaleString('vi-VN')} đ

              if orderDetail.discount > 0
                li
                  span.label 
                    | Giảm giá 
                    if orderDetail.couponCode
                      strong (Mã: #{orderDetail.couponCode})
                    | :
                  span.value - #{orderDetail.discount.toLocaleString('vi-VN')} đ
              li.total-row
                span.label Tổng thanh toán:
                span.value.price-red #{orderDetail.total.toLocaleString('vi-VN')} đ
        if orderDetail.products && orderDetail.products.length > 0
          .success-products-section
            h3.success-card__title.text-center
              i.fa-solid.fa-box-open
              | Sản phẩm đã mua
              
            .success-products-list
              each item in orderDetail.products
                .success-product-item
                  .product-img
                    a(href=`/product/detail/${item.slug}`)
                      img(src=item.thumbnail alt=item.title)
                  .product-info
                    a(href=`/product/detail/${item.slug}`)
                      h4.product-name #{item.title}
                    if item.size
                      p.product-variant Phân loại: #{item.size}
                    p.product-qty Số lượng: x#{item.quantity}
                  .product-price
                    strong.price-red #{item.priceNewQuantity.toLocaleString('vi-VN')} đ
        .success-actions
          a.btn-submit-cart.btn-continue-shopping(href="/") 
            | Tiếp tục mua sắm
          button.btn-print-invoice(onclick="window.print()")
            i.fa-solid.fa-print
            | In hóa đơn

    script(src="/client/assets/js/order-success.js")