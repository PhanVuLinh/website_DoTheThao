extends ../layouts/default.pug
include ../mixins/product-item.pug

block main
  //- ==========================================
  //- 1. BANNER CHÍNH & HERO CAROUSEL TRANG CHỦ
  //- ==========================================
  - var activeHeroSlides = (settingWebsiteInfo && settingWebsiteInfo.heroSlides && settingWebsiteInfo.heroSlides.length > 0) ? settingWebsiteInfo.heroSlides : [{ badge: (settingWebsiteInfo && settingWebsiteInfo.heroBadge ? settingWebsiteInfo.heroBadge : "🏆 THẾ GIỚI ĐỒ THỂ THAO CHÍNH HÃNG"), title: (settingWebsiteInfo && settingWebsiteInfo.heroTitle ? settingWebsiteInfo.heroTitle : "BỨT PHÁ<br>MỌI GIỚI HẠN"), description: (settingWebsiteInfo && settingWebsiteInfo.heroDescription ? settingWebsiteInfo.heroDescription : "Trải nghiệm đẳng cấp với bộ sưu tập thể thao chính hãng mới nhất. Chất lượng vượt trội, thiết kế tối ưu cho mọi chuyển động."), btnText: (settingWebsiteInfo && settingWebsiteInfo.heroBtnText ? settingWebsiteInfo.heroBtnText : "Khám Phá Ngay"), btnLink: (settingWebsiteInfo && settingWebsiteInfo.heroBtnLink ? settingWebsiteInfo.heroBtnLink : "/product"), secondaryBtnText: "Săn Voucher Hot", secondaryBtnLink: "#voucher-vault", image: (settingWebsiteInfo ? settingWebsiteInfo.heroImage : ""), showcaseTag: "🔥 BEST SELLER MÙA GIẢI", showcaseTitle: "Nike Mercurial Superfly 9 Elite FG", showcasePrice: "2.450.000đ", showcaseOldPrice: "3.200.000đ", showcaseImage: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80", showcaseLink: "/product" }, { badge: "⚡ BẢO VỆ & BẬT NHẢY ĐỈNH CAO", title: "BẬT CAO<br>CHINH PHỤC ĐỈNH", description: "Dụng cụ và giày bóng chuyền chuyên nghiệp chuẩn thi đấu quốc tế. Êm ái, đàn hồi và bảo vệ khớp cổ chân tối đa.", btnText: "Xem Đồ Bóng Chuyền", btnLink: "/category/bong-chuyen", secondaryBtnText: "Ưu Đãi Hôm Nay", secondaryBtnLink: "#voucher-vault", image: "https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=1600&auto=format&fit=crop&q=80", showcaseTag: "⚡ GIỜ VÀNG GIÁ SỐC", showcaseTitle: "Mizuno Wave Momentum 3 Pro", showcasePrice: "2.450.000đ", showcaseOldPrice: "2.850.000đ", showcaseImage: "https://images.unsplash.com/photo-1584735935682-2f2b69dff9d2?w=600&auto=format&fit=crop&q=80", showcaseLink: "/product" }]

  section.hero.hero-carousel-section
    .swiper.hero-swiper
      .swiper-wrapper
        each slide, idx in activeHeroSlides
          .swiper-slide.hero-slide
            if slide.image
              img.hero__img(src=slide.image alt=(slide.title ? slide.title.replace(/<[^>]*>/g, '') : "Banner TitiSport"))
            else if settingWebsiteInfo && settingWebsiteInfo.heroImage
              img.hero__img(src=settingWebsiteInfo.heroImage alt="Banner TitiSport")
            else
              .hero__placeholder-bg
            .hero__overlay
            .hero__container.container
              .hero__grid-layout
                //- CỘT 1: NỘI DUNG VÀ TƯƠNG TÁC
                .hero__content
                  if slide.badge
                    .hero__badge 
                      i.fa-solid.fa-trophy
                      span !{slide.badge}
                      
                  h1.hero__title !{slide.title || "BỨT PHÁ<br>MỌI GIỚI HẠN"}
                  p.hero__description #{slide.description || "Trải nghiệm đẳng cấp với bộ sưu tập thể thao chính hãng mới nhất. Chất lượng vượt trội, thiết kế tối ưu cho mọi chuyển động."}
                  
                  .hero__cta-group
                    a.btn-hero-primary(href=(slide.btnLink || "/product"))
                      span #{slide.btnText || "Khám Phá Ngay"}
                      i.fa-solid.fa-arrow-right
                    if slide.secondaryBtnText
                      a.btn-hero-secondary(href=(slide.secondaryBtnLink || "#voucher-vault"))
                        i.fa-solid.fa-ticket
                        span #{slide.secondaryBtnText}

                  .hero__search-box
                    form.hero-search-form(action="/search" method="GET" form-search)
                      i.fa-solid.fa-magnifying-glass.icon-search
                      input(placeholder="Tìm kiếm giày bóng đá, bóng chuyền, áo đấu..." type="text" name="keyword" keyword)
                      button(type="submit") Tìm Kiếm

                  .hero__stats-pill
                    .stat-item
                      i.fa-solid.fa-certificate
                      span 100% Chính Hãng
                    .stat-divider
                    .stat-item
                      i.fa-solid.fa-truck-bolt
                      span Giao Nhanh 2H
                    .stat-divider
                    .stat-item
                      i.fa-solid.fa-arrow-rotate-left
                      span Đổi Trả 30 Ngày

                //- CỘT 2: THẺ SPOTLIGHT 3D GLASSMORPHISM PHÁT SÁNG LƠ LỬNG
                .hero__visual-column
                  .hero-spotlight-card
                    .spotlight-glow-layer
                    .spotlight-card-header
                      if slide.showcaseTag
                        .spotlight-tag-badge
                          i.fa-solid.fa-bolt
                          span #{slide.showcaseTag}
                    if slide.showcaseImage
                      .spotlight-image-holder
                        img(src=slide.showcaseImage alt=(slide.showcaseTitle || "Sản phẩm nổi bật") loading="lazy")
                    .spotlight-info-box
                      h3.spotlight-item-name #{slide.showcaseTitle || "Sản Phẩm Thể Thao Mới Nhất"}
                      .spotlight-price-row
                        if slide.showcasePrice
                          span.current-price #{slide.showcasePrice}
                        if slide.showcaseOldPrice
                          span.original-price #{slide.showcaseOldPrice}
                        .spotlight-stars
                          i.fa-solid.fa-star
                          i.fa-solid.fa-star
                          i.fa-solid.fa-star
                          i.fa-solid.fa-star
                          i.fa-solid.fa-star
                      a.btn-spotlight-view(href=(slide.showcaseLink || "/product"))
                        span Khám Phá Ngay
                        i.fa-solid.fa-arrow-right-long

                  //- Floating Mini Badges
                  .floating-feature-badge.floating-feature-badge--top
                    .badge-icon-circle
                      i.fa-solid.fa-fire
                    .badge-text-wrap
                      strong Ưu Đãi Hấp Dẫn
                      span Giảm đến 50% hôm nay
                  
                  .floating-feature-badge.floating-feature-badge--bottom
                    .badge-icon-circle
                      i.fa-solid.fa-shield-halved
                    .badge-text-wrap
                      strong Bảo Hành Chính Hãng
                      span Đổi mới trong 30 ngày

      //- Swiper Điều Hướng
      .hero-swiper-pagination
      .hero-nav-arrow.hero-nav-arrow--prev(aria-label="Slide trước")
        i.fa-solid.fa-chevron-left
      .hero-nav-arrow.hero-nav-arrow--next(aria-label="Slide tiếp theo")
        i.fa-solid.fa-chevron-right

  //- ==========================================
  //- 2. CHÍNH SÁCH & CAM KẾT VỚI KHÁCH HÀNG
  //- ==========================================
  section.trust-features
    .trust-features__container
      .trust-grid
        .trust-card
          .trust-icon.trust-icon--speed
            i.fa-solid.fa-truck-fast
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge1_title ? settingWebsiteInfo.trustBadge1_title : "Giao Hàng Hỏa Tốc 2H"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge1_desc ? settingWebsiteInfo.trustBadge1_desc : "Nhận hàng ngay trong ngày, hỗ trợ kiểm tra hàng trước khi thanh toán."}
        
        .trust-card
          .trust-icon.trust-icon--shield
            i.fa-solid.fa-shield-halved
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge2_title ? settingWebsiteInfo.trustBadge2_title : "100% Hàng Chính Hãng"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge2_desc ? settingWebsiteInfo.trustBadge2_desc : "Cam kết chất lượng quốc tế, đền bù gấp 10 lần nếu phát hiện hàng nhái."}
        
        .trust-card
          .trust-icon.trust-icon--return
            i.fa-solid.fa-arrow-rotate-left
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge3_title ? settingWebsiteInfo.trustBadge3_title : "Đổi Trả Miễn Phí 30 Ngày"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge3_desc ? settingWebsiteInfo.trustBadge3_desc : "Hỗ trợ đổi size linh hoạt tận nơi, thủ tục đơn giản trong 1 phút."}
        
        .trust-card
          .trust-icon.trust-icon--support
            i.fa-solid.fa-headset
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge4_title ? settingWebsiteInfo.trustBadge4_title : "Tư Vấn Chuyên Nghiệp 24/7"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge4_desc ? settingWebsiteInfo.trustBadge4_desc : "Đội ngũ am hiểu sâu về dụng cụ và giày thể thao chuyên dụng."}

  //- ==========================================
  //- 3. KHO VOUCHER KHUYẾN MÃI
  //- ==========================================
  if couponList && couponList.length > 0
    section.voucher-vault.home-section#voucher-vault
      .voucher-vault__container
        .section-header-wrap
          .section-header-left
            .section-tag
              i.fa-solid.fa-wallet
              | ƯU ĐÃI DÀNH CHO BẠN
            h2.section-title Kho Voucher Giảm Giá
            p.section-subtitle Thu thập mã ưu đãi để nhận giảm giá trực tiếp khi thanh toán đơn hàng.
          
          .section-header-right
            .voucher-vault__summary-pill
              i.fa-solid.fa-ticket
              span #{couponList.length} Mã khả dụng
            button.btn-vault-hot-copy(type="button" data-code=couponList[0].code title="Sao chép ngay mã giảm giá cao nhất")
              i.fa-solid.fa-bolt
              span Sao chép mã HOT nhất

        .voucher-grid
          each coupon, index in couponList
            .voucher-ticket(class=`voucher-ticket--theme-${index % 4}`)
              .voucher-ticket__top
                .voucher-ticket__badge-row
                  span.voucher-ticket__brand
                    i.fa-solid.fa-medal
                    | VOUCHER ƯU ĐÃI
                  span.voucher-ticket__pct -#{coupon.discountPercentage}%
                
                .voucher-ticket__hero
                  .voucher-ticket__amount
                    span.amount-num #{coupon.discountPercentage}
                    span.amount-unit %
                    span.amount-label GIẢM
                  .voucher-ticket__code-box
                    span.code-label MÃ VOUCHER
                    span.code-text= coupon.code

                .voucher-ticket__notch.voucher-ticket__notch--left
                .voucher-ticket__dashed-divider
                .voucher-ticket__notch.voucher-ticket__notch--right

              .voucher-ticket__bottom
                h4.voucher-ticket__title= coupon.title
                p.voucher-ticket__limit Giảm tối đa #{coupon.maxDiscountAmount ? coupon.maxDiscountAmount.toLocaleString('vi-VN') : '0'} đ cho đơn hàng
                
                .voucher-ticket__footer
                  span.voucher-ticket__exp(title=`Hạn sử dụng: ${coupon.expirationDateFormatted}`)
                    i.fa-regular.fa-clock
                    | HSD: #{coupon.expirationDateFormatted}
                  span.voucher-ticket__state
                    i.fa-solid.fa-circle-check
                    | Khả dụng

                button.btn-ticket-copy.btn-copy-voucher(type="button" data-code=coupon.code title="Bấm để sao chép mã")
                  i.fa-regular.fa-copy
                  span.copy-text Sao chép mã

  //- ==========================================
  //- 4. KHÁM PHÁ BỘ MÔN THỂ THAO (SPORTS HUB)
  //- ==========================================
  if categoryChildren && categoryChildren.length > 0
    section.sports-hub.home-section#sportsHubSection
      .container
        .section-header-center
          .section-tag
            i.fa-solid.fa-trophy
            | BỘ SƯU TẬP THỂ THAO
          h2.sports-hub__title Khám Phá Theo Từng Bộ Môn
          p.section-subtitle Đầy đủ trang thiết bị chuyên dụng phục vụ mọi cấp độ từ phong trào đến thi đấu chuyên nghiệp.

        //- 1. BỘ LỌC THỂ THAO DẠNG VIÊN THUỐC (SPORT PILL TABS)
        .sports-nav-pills
          button.sport-pill-btn.active(type="button" data-sport="all")
            i.fa-solid.fa-fire-flame-curved
            span Tất Cả Bộ Môn
            span.pill-count #{storeStats && storeStats.totalProducts ? storeStats.totalProducts : categoryChildren.length}
          if sportHubList && sportHubList.length > 0
            each sport in sportHubList
              button.sport-pill-btn(type="button" data-sport=sport.slug)
                i(class=sport.icon)
                span #{sport.title}
                span.pill-count #{sport.totalProducts} sp

        //- 2. 3 HERO SPORT SHOWCASE CARDS (BÓNG ĐÁ, BÓNG CHUYỀN, CẦU LÔNG)
        if sportHubList && sportHubList.length > 0
          .sport-hero-showcase#sportHeroShowcase
            each sport in sportHubList
              .sport-hero-card(class=sport.theme data-sport=sport.slug)
                .sport-hero-bg
                  img(
                    src=sport.bannerImage 
                    alt=sport.title 
                    loading="lazy"
                    onerror="this.src='https://images.unsplash.com/photo-1517649763962-0c623266ddc0?w=900&auto=format&fit=crop&q=80'"
                  )
                  .sport-hero-overlay
                .sport-hero-content
                  .sport-hero-top
                    span.sport-hero-badge
                      i(class=sport.icon)
                      | #{sport.badge}
                    span.sport-hero-count #{sport.totalProducts}+ Sản phẩm
                  h3.sport-hero-heading #{sport.title}
                  p.sport-hero-tagline #{sport.tagline}
                  p.sport-hero-desc #{sport.description}

                  //- Quick subcategory chips
                  if sport.subcategories && sport.subcategories.length > 0
                    .sport-quick-chips
                      each sub in sport.subcategories
                        a.quick-chip(href=`/category/${sub.slug}`)
                          span #{sub.title}
                          i.fa-solid.fa-angle-right

                  .sport-hero-footer
                    a.btn-sport-explore(href=`/category/${sport.slug}`)
                      span Đến Cửa Hàng #{sport.title}
                      i.fa-solid.fa-arrow-right

        //- 3. LƯỚI DANH MỤC THIẾT BỊ CHI TIẾT
        .sports-categories-wrap
          .subcats-header-bar
            .subcats-header-left
              i.fa-solid.fa-cubes-stacked
              span.subcats-header-title Danh Mục Thiết Bị Chuyên Dụng
            span.subcats-count-badge#subcatsCountDisplay #{categoryChildren.length} danh mục

          .sports-categories-grid#sportsCategoriesGrid
            each cat in categoryChildren
              a.sport-category-card(
                href=`/category/${cat.slug}`
                data-sport=(cat.parentSlug || 'other')
              )
                .sport-cat-header
                  span.sport-parent-tag
                    i(class=(cat.parentIcon || 'fa-solid fa-trophy'))
                    | #{cat.parentTitle || 'Thể thao'}
                  if cat.productCount > 0
                    span.sport-stock-badge #{cat.productCount} sp
                .sport-cat-thumb
                  img(
                    src=cat.thumbnail
                    alt=cat.title
                    loading="lazy"
                    onerror="this.src='https://placehold.co/240x240/f1f5f9/94a3b8?text=' + encodeURIComponent(this.alt || 'Sport')"
                  )
                .sport-cat-info
                  h4.sport-cat-title(title=cat.title)= cat.title
                  .sport-cat-action
                    span Khám phá ngay
                    i.fa-solid.fa-arrow-right

  //- ==========================================
  //- 5. GIỜ VÀNG GIÁ SỐC (FLASH SALE)
  //- ==========================================
  if activeFlashSale && productListSection3 && productListSection3.length > 0
    section.flash-deals.home-section
      .flash-deals__container
        .flash-promo
          .flash-promo__badge
            span.live-pulse-dot
            | #{activeFlashSale.badge || '⚡ DEAL CHỚP NHOÁNG'}
          h2.flash-promo__title-new
            span.title-sub #{activeFlashSale.subTitle || 'SỐ LƯỢNG CÓ HẠN'}
            span.title-main #{activeFlashSale.title}
          p.flash-promo__desc #{activeFlashSale.description || 'Trang bị thể thao chính hãng giá tốt nhất - Số lượng có hạn, săn ngay hôm nay!'}
          
          .flash-promo__timer-wrapper
            p.flash-promo__countdown-label
              i.fa-regular.fa-clock
              | ƯU ĐÃI KẾT THÚC SAU
            .flash-promo__countdown#flashCountdown(data-end=(activeFlashSale.endTime ? new Date(activeFlashSale.endTime).toISOString() : ""))
              .countdown-box
                span.num#cdHours 00
                span.label GIỜ
              span.colon :
              .countdown-box
                span.num#cdMinutes 00
                span.label PHÚT
              span.colon :
              .countdown-box
                span.num#cdSeconds 00
                span.label GIÂY

          a.flash-promo__btn(href="/product")
            span Khám Phá Toàn Bộ Deal Hot
            i.fa-solid.fa-arrow-right

        .flash-products-wrapper
          button.flash-nav-btn.flash-nav-btn--prev(type="button" aria-label="Lùi lại")
            i.fa-solid.fa-chevron-left
          button.flash-nav-btn.flash-nav-btn--next(type="button" aria-label="Tiến tới")
            i.fa-solid.fa-chevron-right
          .flash-products-list#flashProductsList
            each item, index in productListSection3
              .flash-product-item
                .flash-deal-card
                  button.btn-wishlist-toggle(
                    type="button"
                    data-id=(item.id || item._id)
                    data-title=item.title
                    data-slug=item.slug
                    data-price=(item.priceNew || item.price)
                    data-price-old=item.price
                    data-thumbnail=(item.thumbnail || (item.images && item.images[0]) || "")
                    title="Yêu thích sản phẩm"
                    aria-label="Yêu thích"
                  )
                    i.fa-regular.fa-heart

                  button.btn-compare-toggle(
                    type="button"
                    data-id=(item.id || item._id)
                    data-title=item.title
                    data-slug=item.slug
                    data-price=(item.priceNew || item.price)
                    data-price-old=item.price
                    data-thumbnail=(item.thumbnail || (item.images && item.images[0]) || "")
                    data-brand=(item.brand || "CHÍNH HÃNG")
                    title="So sánh sản phẩm"
                    aria-label="So sánh"
                  )
                    i.fa-solid.fa-code-compare

                  a.flash-deal-card__link(href=`/product/detail/${item.slug}`)
                    .flash-deal-card__img-box
                      .card-badges-stack
                        if item.discountPercentage > 0
                          span.flash-badge-discount
                            i.fa-solid.fa-bolt
                            | -#{item.discountPercentage}%
                        if item.featured == "1"
                          span.flash-badge-hot HOT
                        else if item.isNew == true
                          span.flash-badge-new MỚI
                      
                      img.flash-deal-card__img(
                        src=(item.thumbnail || (item.images && item.images[0]) || "https://placehold.co/400x400/f8fafc/94a3b8?text=TITISPORT")
                        alt=item.title
                        loading="lazy"
                        onerror="this.onerror=null; this.src='https://placehold.co/400x400/f8fafc/94a3b8?text=TITISPORT'"
                      )

                      .flash-deal-card__quick-overlay
                        span.quick-view-pill
                          i.fa-solid.fa-eye
                          | Xem nhanh
                    
                    .flash-deal-card__info
                      span.flash-deal-card__brand
                        i.fa-solid.fa-shield-halved
                        | #{item.brand || 'CHÍNH HÃNG 100%'}
                      h3.flash-deal-card__title(title=item.title) #{item.title}
                      
                      .flash-deal-card__rating
                        .stars-group
                          - for (let i = 0; i < 5; i++)
                            i.fa-solid.fa-star
                        span.rating-score (5.0)
                        span.rating-verified
                          i.fa-solid.fa-circle-check
                          | Đã xác thực

                  .deal-progress-wrap
                    .deal-progress-bar
                      .deal-progress-fill(style=`width: ${item.percentSold || 0}%`)
                    .deal-progress-text
                      span.sold-text
                        i.fa-solid.fa-fire-flame-curved
                        if item.quantityQuota > 0
                          if (item.soldCount > 0)
                            | Đã bán #{item.soldCount}/#{item.quantityQuota}
                          else
                            | Mở bán #{item.quantityQuota} suất
                        else
                          if (item.soldCount > 0)
                            | Đã bán #{item.soldCount}
                          else
                            | Đang mở bán
                      if ((item.percentSold || 0) >= 80)
                        span.stock-tag Sắp cháy hàng
                      else if ((item.percentSold || 0) >= 40)
                        span.stock-tag Bán cực chạy
                      else if (!item.soldCount || item.soldCount === 0)
                        span.stock-tag Vừa mở bán
                      else
                        span.stock-tag Đang mở bán

                  .flash-deal-card__footer
                    .flash-deal-card__price-group
                      if (item.priceNew && item.priceNew < item.price)
                        span.deal-old-price #{item.price.toLocaleString('vi-VN')}đ
                        span.deal-new-price #{item.priceNew.toLocaleString('vi-VN')}đ
                      else
                        span.deal-new-price #{(item.price || 0).toLocaleString('vi-VN')}đ
                    
                    a.btn-deal-cart(href=`/product/detail/${item.slug}` title="Xem chi tiết & Săn ngay")
                      i.fa-solid.fa-bolt
                      span Săn ngay

  //- ==========================================
  //- 6. SẢN PHẨM THEO BỘ MÔN THỂ THAO
  //- ==========================================
  section.sports-hub-section.home-section
    .sports-hub-container
      .section-header-wrap
        .section-header-left
          .section-tag
            i.fa-solid.fa-medal
            | BỘ SƯU TẬP CHÍNH HÃNG
          h2.section-title Sản Phẩm Theo Bộ Môn
          p.section-subtitle Lựa chọn trang phục và phụ kiện phù hợp nhất cho môn thể thao yêu thích của bạn.
        
        .sports-hub-tabs(sports-hub-tabs)
          button.hub-tab-btn.is-active(type="button" data-tab-target="tab-featured")
            i.fa-solid.fa-fire
            | Sản Phẩm Nổi Bật
          button.hub-tab-btn(type="button" data-tab-target="tab-football")
            i.fa-solid.fa-futbol
            | #{sportsTab1 ? sportsTab1.title : 'Bóng Đá'}
          button.hub-tab-btn(type="button" data-tab-target="tab-volleyball")
            i.fa-solid.fa-volleyball
            | #{sportsTab2 ? sportsTab2.title : 'Bóng Chuyền'}
          button.hub-tab-btn(type="button" data-tab-target="tab-newest")
            i.fa-solid.fa-bolt
            | Hàng Mới Về

      // Tab Panels
      .sports-hub-panels
        // 1. Tab Featured
        .hub-panel.is-active#tab-featured
          .featured-products__grid
            if productFeaturedSection5 && productFeaturedSection5.length > 0
              each item in productFeaturedSection5
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm...
        
        // 2. Tab Sports 1
        .hub-panel#tab-football
          .featured-products__grid
            if footballProducts && footballProducts.length > 0
              each item in footballProducts
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm #{sportsTab1 ? sportsTab1.title.toLowerCase() : 'thể thao'}...
        
        // 3. Tab Sports 2
        .hub-panel#tab-volleyball
          .featured-products__grid
            if volleyballProducts && volleyballProducts.length > 0
              each item in volleyballProducts
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm #{sportsTab2 ? sportsTab2.title.toLowerCase() : 'thể thao'}...
        
        // 4. Tab Newest
        .hub-panel#tab-newest
          .featured-products__grid
            if productListSection7 && productListSection7.length > 0
              each item in productListSection7
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm mới...

      .sports-hub-footer
        a.btn-view-all-glow(href="/product")
          | Xem Toàn Bộ Sản Phẩm
          i.fa-solid.fa-arrow-right-long

  //- ==========================================
  //- 7. BANNER QUẢNG CÁO KHUYẾN MÃI
  //- ==========================================
  if settingWebsiteInfo && (settingWebsiteInfo.promoBannerImage || settingWebsiteInfo.promoBannerTitle)
    section.banner-promo.home-section
      .banner-promo__container
        .banner-promo__inner
          a.banner-promo__link(href=(settingWebsiteInfo.promoBannerLink || "/product"))
            if settingWebsiteInfo.promoBannerImage
              img(src=settingWebsiteInfo.promoBannerImage alt=(settingWebsiteInfo.promoBannerTitle || "Banner Khuyến Mãi Đặc Biệt") loading="lazy")
            if settingWebsiteInfo.promoBannerTitle
              .banner-promo__glass-tag
                i.fa-solid.fa-star
                span #{settingWebsiteInfo.promoBannerTitle} #{settingWebsiteInfo.promoBannerSubtitle ? ' - ' + settingWebsiteInfo.promoBannerSubtitle : ''}

  //- ==========================================
  //- 8. ĐÁNH GIÁ TỪ KHÁCH HÀNG
  //- ==========================================
  if testimonialsList && testimonialsList.length > 0
    section.testimonials-section.home-section
      .testimonials-container
        .section-header-center
          .section-tag
            i.fa-solid.fa-heart
            | ĐÁNH GIÁ THỰC TẾ
          h2.section-title Khách Hàng Nói Về #{settingWebsiteInfo.websiteName || 'TitiSport'}
          p.section-subtitle Hàng ngàn vận động viên và người yêu thể thao đã tin tưởng đồng hành.

        .testimonials-grid
          each item in testimonialsList
            .testimonial-card
              .testimonial-rating
                - const stars = item.rating || 5
                - for (let s = 0; s < stars; s++)
                  i.fa-solid.fa-star
              p.testimonial-text "#{item.comment}"
              .testimonial-author
                .author-avatar
                  img(src=(item.avatar || "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&h=120&q=80") alt=item.fullName loading="lazy")
                .author-meta
                  strong.author-name= item.fullName
                  if item.tagline
                    span.author-tag= item.tagline
                  else if item.isVerifiedBuyer
                    span.author-tag Khách hàng đã mua hàng chính hãng

  //- ==========================================
  //- 9. BÀI VIẾT & KINH NGHIỆM THỂ THAO
  //- ==========================================
  if articleListSection9 && articleListSection9.length > 0 || newsCenter
    section.news-section.home-section
      .news-section__container
        .section-header-wrap
          .section-header-left
            .section-tag
              i.fa-solid.fa-newspaper
              | CẨM NANG THỂ THAO
            h2.section-title Tin Tức & Kiến Thức Mới Nhất
            p.section-subtitle Bí quyết tập luyện, kỹ năng chọn trang bị và xu hướng thể thao cập nhật liên tục.
          
          .section-header-right
            a.btn-view-articles(href="/article")
              | Xem Tất Cả Bài Viết
              i.fa-solid.fa-arrow-right
        
        .news-grid
          if newsLeft && newsLeft.length > 0
            .news-col.news-col--side
              each item in newsLeft
                a.news-card-small(href=`/article/detail/${item.slug}`)
                  img(src=item.thumbnail, alt=item.title loading="lazy")
                  .news-card-small__overlay
                    span.date
                      i.fa-regular.fa-calendar
                      |  #{item.createdAtFormat}
                    h4.title= item.title

          if newsCenter
            .news-col.news-col--center
              article.news-card-large
                a.news-card-large__img(href=`/article/detail/${newsCenter.slug}`)
                  img(src=newsCenter.thumbnail, alt=newsCenter.title loading="lazy")
                .news-card-large__content
                  span.date
                    i.fa-regular.fa-calendar
                    |  #{newsCenter.createdAtFormat}
                  h3.title
                    a(href=`/article/detail/${newsCenter.slug}`)= newsCenter.title
                  p.desc= newsCenter.description
                  a.read-more-link(href=`/article/detail/${newsCenter.slug}`)
                    | Đọc tiếp
                    i.fa-solid.fa-arrow-right

          if newsRight && newsRight.length > 0
            .news-col.news-col--side
              each item in newsRight
                a.news-card-small(href=`/article/detail/${item.slug}`)
                  img(src=item.thumbnail, alt=item.title loading="lazy")
                  .news-card-small__overlay
                    span.date
                      i.fa-regular.fa-calendar
                      |  #{item.createdAtFormat}
                    h4.title= item.title

  //- ==========================================
  //- 10. THƯƠNG HIỆU ĐỐI TÁC CHÍNH HÃNG
  //- ==========================================
  if brandList && brandList.length > 0
    section.brands-section.home-section
      .brands-container
        .section-header-center
          .section-tag
            i.fa-solid.fa-certificate
            | THƯƠNG HIỆU ĐỐI TÁC
          h2.section-title Đối Tác Thể Thao Toàn Cầu
          p.section-subtitle #{settingWebsiteInfo.websiteName || 'TitiSport'} tự hào phân phối chính hãng các thương hiệu dụng cụ và trang phục thi đấu hàng đầu thế giới.

        .brands-showcase-wrap
          .brands-logos-list
            each item in brandList
              a.brand-logo-item(
                href=(item.link || `/?keyword=${item.name}`)
                title=`Thương hiệu ${item.name} - Phân phối chính hãng`
              )
                if item.logo
                  img.brand-logo-img(src=item.logo alt=`${item.name} Logo` loading="lazy")
                else
                  span.brand-logo-fallback
                    i.fa-solid.fa-certificate
                    span= item.name

  script(src="/client/assets/js/flash-sale.js")