extends ../layouts/default.pug
include ../mixins/product-item.pug

block main
  //- ==========================================
  //- 1. BANNER CHÍNH ĐẦU TRANG
  //- ==========================================
  section.hero
    img.hero__img(src=(settingWebsiteInfo.heroImage ? settingWebsiteInfo.heroImage : "") alt=settingWebsiteInfo.websiteName)
    .hero__overlay
    .hero__container 
      .hero__content
        if settingWebsiteInfo.heroBadge
          .hero__badge 
            i.fa-solid.fa-trophy
            | #{settingWebsiteInfo.heroBadge}
            
        h1.hero__title !{settingWebsiteInfo.heroTitle || "BỨT PHÁ<br>MỌI GIỚI HẠN"}
        p.hero__description #{settingWebsiteInfo.heroDescription || "Trải nghiệm đẳng cấp với bộ sưu tập thể thao chính hãng mới nhất. Chất lượng vượt trội, thiết kế tối ưu cho mọi chuyển động."}
        
        .hero__cta-group
          a.btn-hero-primary(href=(settingWebsiteInfo && settingWebsiteInfo.heroBtnLink ? settingWebsiteInfo.heroBtnLink : "/product"))
            | #{settingWebsiteInfo && settingWebsiteInfo.heroBtnText ? settingWebsiteInfo.heroBtnText : "Khám Phá Ngay"}
            i.fa-solid.fa-arrow-right
          if couponList && couponList.length > 0
            a.btn-hero-secondary(href="#voucher-vault")
              i.fa-solid.fa-ticket
              | Săn Voucher Hot

        .hero__search-box
          form.hero-search-form(form-search)
            i.fa-solid.fa-magnifying-glass.icon-search
            input(placeholder="Tìm kiếm giày bóng đá, bóng chuyền, áo đấu..." type="text" name="keyword" keyword)
            button(type="submit") Tìm Kiếm

        .hero__stats-pill
          .stat-item
            i.fa-solid.fa-certificate
            span 100% Chính Hãng
          .stat-divider
          .stat-item
            i.fa-solid.fa-truck-bolt
            span Giao Nhanh 2H
          .stat-divider
          .stat-item
            i.fa-solid.fa-arrow-rotate-left
            span Đổi Trả 30 Ngày

  //- ==========================================
  //- 2. CHÍNH SÁCH & CAM KẾT VỚI KHÁCH HÀNG
  //- ==========================================
  section.trust-features
    .trust-features__container
      .trust-grid
        .trust-card
          .trust-icon.trust-icon--speed
            i.fa-solid.fa-truck-fast
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge1_title ? settingWebsiteInfo.trustBadge1_title : "Giao Hàng Hỏa Tốc 2H"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge1_desc ? settingWebsiteInfo.trustBadge1_desc : "Nhận hàng ngay trong ngày, hỗ trợ kiểm tra hàng trước khi thanh toán."}
        
        .trust-card
          .trust-icon.trust-icon--shield
            i.fa-solid.fa-shield-halved
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge2_title ? settingWebsiteInfo.trustBadge2_title : "100% Hàng Chính Hãng"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge2_desc ? settingWebsiteInfo.trustBadge2_desc : "Cam kết chất lượng quốc tế, đền bù gấp 10 lần nếu phát hiện hàng nhái."}
        
        .trust-card
          .trust-icon.trust-icon--return
            i.fa-solid.fa-arrow-rotate-left
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge3_title ? settingWebsiteInfo.trustBadge3_title : "Đổi Trả Miễn Phí 30 Ngày"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge3_desc ? settingWebsiteInfo.trustBadge3_desc : "Hỗ trợ đổi size linh hoạt tận nơi, thủ tục đơn giản trong 1 phút."}
        
        .trust-card
          .trust-icon.trust-icon--support
            i.fa-solid.fa-headset
          .trust-info
            h4.trust-title #{settingWebsiteInfo && settingWebsiteInfo.trustBadge4_title ? settingWebsiteInfo.trustBadge4_title : "Tư Vấn Chuyên Nghiệp 24/7"}
            p.trust-desc #{settingWebsiteInfo && settingWebsiteInfo.trustBadge4_desc ? settingWebsiteInfo.trustBadge4_desc : "Đội ngũ am hiểu sâu về dụng cụ và giày thể thao chuyên dụng."}

  //- ==========================================
  //- 3. KHO VOUCHER KHUYẾN MÃI
  //- ==========================================
  if couponList && couponList.length > 0
    section.voucher-vault#voucher-vault
      .voucher-vault__container
        .section-header-wrap
          .section-header-left
            .section-tag
              i.fa-solid.fa-wallet
              | ƯU ĐÃI DÀNH CHO BẠN
            h2.section-title Kho Voucher Giảm Giá
            p.section-subtitle Thu thập mã ưu đãi để nhận giảm giá trực tiếp khi thanh toán đơn hàng.
          
          .section-header-right
            .voucher-vault__summary-pill
              i.fa-solid.fa-ticket
              span #{couponList.length} Mã khả dụng
            button.btn-vault-hot-copy(type="button" data-code=couponList[0].code title="Sao chép ngay mã giảm giá cao nhất")
              i.fa-solid.fa-bolt
              span Sao chép mã HOT nhất

        .voucher-grid
          each coupon, index in couponList
            .voucher-ticket(class=`voucher-ticket--theme-${index % 4}`)
              .voucher-ticket__top
                .voucher-ticket__badge-row
                  span.voucher-ticket__brand
                    i.fa-solid.fa-medal
                    | VOUCHER ƯU ĐÃI
                  span.voucher-ticket__pct -#{coupon.discountPercentage}%
                
                .voucher-ticket__hero
                  .voucher-ticket__amount
                    span.amount-num #{coupon.discountPercentage}
                    span.amount-unit %
                    span.amount-label GIẢM
                  .voucher-ticket__code-box
                    span.code-label MÃ VOUCHER
                    span.code-text= coupon.code

                .voucher-ticket__notch.voucher-ticket__notch--left
                .voucher-ticket__dashed-divider
                .voucher-ticket__notch.voucher-ticket__notch--right

              .voucher-ticket__bottom
                h4.voucher-ticket__title= coupon.title
                p.voucher-ticket__limit Giảm tối đa #{coupon.maxDiscountAmount ? coupon.maxDiscountAmount.toLocaleString('vi-VN') : '0'} đ cho đơn hàng
                
                .voucher-ticket__footer
                  span.voucher-ticket__exp(title=`Hạn sử dụng: ${coupon.expirationDateFormatted}`)
                    i.fa-regular.fa-clock
                    | HSD: #{coupon.expirationDateFormatted}
                  span.voucher-ticket__state
                    i.fa-solid.fa-circle-check
                    | Khả dụng

                button.btn-ticket-copy.btn-copy-voucher(type="button" data-code=coupon.code title="Bấm để sao chép mã")
                  i.fa-regular.fa-copy
                  span.copy-text Sao chép mã

  //- ==========================================
  //- 4. KHÁM PHÁ DANH MỤC SẢN PHẨM
  //- ==========================================
  section.categories
    .categories__container
      .section-header-center
        .section-tag
          i.fa-solid.fa-layer-group
          | BỘ SƯU TẬP
        h2.categories__title Khám Phá Bộ Môn Thể Thao
        p.section-subtitle Đầy đủ trang thiết bị chuyên dụng phục vụ mọi cấp độ từ phong trào đến thi đấu chuyên nghiệp.

      .categories__grid
        if categoryChildren && categoryChildren.length > 0
          each cat in categoryChildren
            a.category-card(href=`/category/${cat.slug}`)
              .category-card__img-wrap
                img(src=cat.thumbnail, alt=cat.title loading="lazy")
              h3.category-card__title= cat.title
              span.category-card__action
                | Khám phá
                i.fa-solid.fa-chevron-right

  //- ==========================================
  //- 5. GIỜ VÀNG GIÁ SỐC (FLASH SALE)
  //- ==========================================
  if (settingWebsiteInfo.flashSaleActive !== false) && productListSection3 && productListSection3.length > 0
    section.flash-deals
      .flash-deals__container
        .flash-promo
          .flash-promo__badge
            span.live-pulse-dot
            | #{settingWebsiteInfo.flashSaleBadge || 'GIỜ VÀNG GIÁ SỐC'}
          h2.flash-promo__title-new
            span.title-sub #{settingWebsiteInfo.flashSaleSubTitle || 'ƯU ĐÃI CÓ HẠN'}
            span.title-main #{settingWebsiteInfo.flashSaleTitle || 'SĂN HÀNG GIÁ TỐT'}
          p.flash-promo__desc #{settingWebsiteInfo.flashSaleDesc || 'Giày thi đấu & trang bị thể thao tuyển chọn giảm sâu số lượng có hạn.'}
          
          .flash-promo__timer-wrapper
            p.flash-promo__countdown-label
              i.fa-regular.fa-clock
              | KẾT THÚC TRONG
            .flash-promo__countdown#flashCountdown(data-end=(settingWebsiteInfo && settingWebsiteInfo.flashSaleEndTime ? new Date(settingWebsiteInfo.flashSaleEndTime).toISOString() : ""))
              .countdown-box
                span.num#cdHours 00
                span.label GIỜ
              span.colon :
              .countdown-box
                span.num#cdMinutes 00
                span.label PHÚT
              span.colon :
              .countdown-box
                span.num#cdSeconds 00
                span.label GIÂY

          a.flash-promo__btn(href=(settingWebsiteInfo.flashSaleLink || "/product"))
            span Xem Tất Cả Khuyến Mãi
            i.fa-solid.fa-arrow-right

        .flash-products-wrapper
          button.flash-nav-btn.flash-nav-btn--prev(type="button" aria-label="Lùi lại")
            i.fa-solid.fa-chevron-left
          button.flash-nav-btn.flash-nav-btn--next(type="button" aria-label="Tiến tới")
            i.fa-solid.fa-chevron-right
          .flash-products-list#flashProductsList
            each item, index in productListSection3
              .flash-product-item
                .flash-deal-card
                  a.flash-deal-card__link(href=`/product/detail/${item.slug}`)
                    .flash-deal-card__img-box
                      if item.discountPercentage > 0
                        span.flash-badge-discount
                          i.fa-solid.fa-bolt
                          | -#{item.discountPercentage}%
                      if item.featured == "1"
                        span.flash-badge-hot HOT
                      else if item.isNew == true
                        span.flash-badge-new MỚI
                      
                      img.flash-deal-card__img(src=item.thumbnail, alt=item.title, loading="lazy")
                      
                      .flash-deal-card__quick-overlay
                        span.quick-view-pill
                          i.fa-solid.fa-eye
                          | Chi tiết sản phẩm
                    
                    .flash-deal-card__info
                      span.flash-deal-card__brand
                        i.fa-solid.fa-shield-halved
                        | #{item.brand || 'CHÍNH HÃNG 100%'}
                      h3.flash-deal-card__title(title=item.title) #{item.title}
                      
                      .flash-deal-card__rating
                        .stars-group
                          - for (let i = 0; i < 5; i++)
                            i.fa-solid.fa-star
                        span.rating-score (5.0)
                        span.rating-verified
                          i.fa-solid.fa-circle-check
                          | Đã xác thực

                  .deal-progress-wrap
                    .deal-progress-bar
                      .deal-progress-fill(style=`width: ${65 + ((index * 11) % 30)}%`)
                    .deal-progress-text
                      span.sold-text
                        i.fa-solid.fa-fire-flame-curved
                        | Đã bán #{15 + index * 7}
                      span.stock-tag Sắp cháy hàng

                  .flash-deal-card__footer
                    .flash-deal-card__price-group
                      if (item.priceNew && item.priceNew < item.price)
                        span.deal-old-price #{item.price.toLocaleString('vi-VN')}đ
                        span.deal-new-price #{item.priceNew.toLocaleString('vi-VN')}đ
                      else
                        span.deal-new-price #{(item.price || 0).toLocaleString('vi-VN')}đ
                    
                    a.btn-deal-cart(href=`/product/detail/${item.slug}` title="Xem chi tiết & Mua ngay")
                      i.fa-solid.fa-cart-shopping
                      span Mua ngay

  //- ==========================================
  //- 6. SẢN PHẨM THEO BỘ MÔN THỂ THAO
  //- ==========================================
  section.sports-hub-section
    .sports-hub-container
      .section-header-wrap
        .section-header-left
          .section-tag
            i.fa-solid.fa-medal
            | BỘ SƯU TẬP CHÍNH HÃNG
          h2.section-title Sản Phẩm Theo Bộ Môn
          p.section-subtitle Lựa chọn trang phục và phụ kiện phù hợp nhất cho môn thể thao yêu thích của bạn.
        
        .sports-hub-tabs(sports-hub-tabs)
          button.hub-tab-btn.is-active(type="button" data-tab-target="tab-featured")
            i.fa-solid.fa-fire
            | Sản Phẩm Nổi Bật
          button.hub-tab-btn(type="button" data-tab-target="tab-football")
            i.fa-solid.fa-futbol
            | #{sportsTab1 ? sportsTab1.title : 'Bóng Đá'}
          button.hub-tab-btn(type="button" data-tab-target="tab-volleyball")
            i.fa-solid.fa-volleyball
            | #{sportsTab2 ? sportsTab2.title : 'Bóng Chuyền'}
          button.hub-tab-btn(type="button" data-tab-target="tab-newest")
            i.fa-solid.fa-bolt
            | Hàng Mới Về

      // Tab Panels
      .sports-hub-panels
        // 1. Tab Featured
        .hub-panel.is-active#tab-featured
          .featured-products__grid
            if productFeaturedSection5 && productFeaturedSection5.length > 0
              each item in productFeaturedSection5
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm...
        
        // 2. Tab Sports 1
        .hub-panel#tab-football
          .featured-products__grid
            if footballProducts && footballProducts.length > 0
              each item in footballProducts
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm #{sportsTab1 ? sportsTab1.title.toLowerCase() : 'thể thao'}...
        
        // 3. Tab Sports 2
        .hub-panel#tab-volleyball
          .featured-products__grid
            if volleyballProducts && volleyballProducts.length > 0
              each item in volleyballProducts
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm #{sportsTab2 ? sportsTab2.title.toLowerCase() : 'thể thao'}...
        
        // 4. Tab Newest
        .hub-panel#tab-newest
          .featured-products__grid
            if productListSection7 && productListSection7.length > 0
              each item in productListSection7
                +productItem(item)
            else
              p.empty-text Đang cập nhật sản phẩm mới...

      .sports-hub-footer
        a.btn-view-all-glow(href="/product")
          | Xem Toàn Bộ Sản Phẩm
          i.fa-solid.fa-arrow-right-long

  //- ==========================================
  //- 7. BANNER QUẢNG CÁO KHUYẾN MÃI
  //- ==========================================
  if settingWebsiteInfo && (settingWebsiteInfo.promoBannerImage || settingWebsiteInfo.promoBannerTitle)
    section.banner-promo
      .banner-promo__container
        .banner-promo__inner
          a.banner-promo__link(href=(settingWebsiteInfo.promoBannerLink || "/product"))
            if settingWebsiteInfo.promoBannerImage
              img(src=settingWebsiteInfo.promoBannerImage alt=(settingWebsiteInfo.promoBannerTitle || "Banner Khuyến Mãi Đặc Biệt") loading="lazy")
            if settingWebsiteInfo.promoBannerTitle
              .banner-promo__glass-tag
                i.fa-solid.fa-star
                span #{settingWebsiteInfo.promoBannerTitle} #{settingWebsiteInfo.promoBannerSubtitle ? ' - ' + settingWebsiteInfo.promoBannerSubtitle : ''}

  //- ==========================================
  //- 8. ĐÁNH GIÁ TỪ KHÁCH HÀNG
  //- ==========================================
  section.testimonials-section
    .testimonials-container
      .section-header-center
        .section-tag
          i.fa-solid.fa-heart
          | ĐÁNH GIÁ THỰC TẾ
        h2.section-title Khách Hàng Nói Về #{settingWebsiteInfo.websiteName || 'TitiSport'}
        p.section-subtitle Hàng ngàn vận động viên và người yêu thể thao đã tin tưởng đồng hành.

      .testimonials-grid
        if testimonialsList && testimonialsList.length > 0
          each item in testimonialsList
            .testimonial-card
              .testimonial-rating
                - const stars = item.rating || 5
                - for (let s = 0; s < stars; s++)
                  i.fa-solid.fa-star
              p.testimonial-text "#{item.comment}"
              .testimonial-author
                .author-avatar
                  img(src=(item.avatar || "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&h=120&q=80") alt=item.fullName loading="lazy")
                .author-meta
                  strong.author-name= item.fullName
                  if item.tagline
                    span.author-tag= item.tagline
                  else if item.isVerifiedBuyer
                    span.author-tag Khách hàng đã mua hàng chính hãng

  //- ==========================================
  //- 9. BÀI VIẾT & KINH NGHIỆM THỂ THAO
  //- ==========================================
  if articleListSection9 && articleListSection9.length > 0 || newsCenter
    section.news-section
      .news-section__container
        .section-header-wrap
          .section-header-left
            .section-tag
              i.fa-solid.fa-newspaper
              | CẨM NANG THỂ THAO
            h2.section-title Tin Tức & Kiến Thức Mới Nhất
            p.section-subtitle Bí quyết tập luyện, kỹ năng chọn trang bị và xu hướng thể thao cập nhật liên tục.
          
          .section-header-right
            a.btn-view-articles(href="/article")
              | Xem Tất Cả Bài Viết
              i.fa-solid.fa-arrow-right
        
        .news-grid
          if newsLeft && newsLeft.length > 0
            .news-col.news-col--side
              each item in newsLeft
                a.news-card-small(href=`/article/detail/${item.slug}`)
                  img(src=item.thumbnail, alt=item.title loading="lazy")
                  .news-card-small__overlay
                    span.date
                      i.fa-regular.fa-calendar
                      |  #{item.createdAtFormat}
                    h4.title= item.title

          if newsCenter
            .news-col.news-col--center
              article.news-card-large
                a.news-card-large__img(href=`/article/detail/${newsCenter.slug}`)
                  img(src=newsCenter.thumbnail, alt=newsCenter.title loading="lazy")
                .news-card-large__content
                  span.date
                    i.fa-regular.fa-calendar
                    |  #{newsCenter.createdAtFormat}
                  h3.title
                    a(href=`/article/detail/${newsCenter.slug}`)= newsCenter.title
                  p.desc= newsCenter.description
                  a.read-more-link(href=`/article/detail/${newsCenter.slug}`)
                    | Đọc tiếp
                    i.fa-solid.fa-arrow-right

          if newsRight && newsRight.length > 0
            .news-col.news-col--side
              each item in newsRight
                a.news-card-small(href=`/article/detail/${item.slug}`)
                  img(src=item.thumbnail, alt=item.title loading="lazy")
                  .news-card-small__overlay
                    span.date
                      i.fa-regular.fa-calendar
                      |  #{item.createdAtFormat}
                    h4.title= item.title

  //- ==========================================
  //- 10. THƯƠNG HIỆU ĐỐI TÁC CHÍNH HÃNG
  //- ==========================================
  section.brands-section
    .brands-container
      .section-header-center
        .section-tag
          i.fa-solid.fa-certificate
          | THƯƠNG HIỆU ĐỐI TÁC
        h2.section-title Đối Tác Thể Thao Toàn Cầu
        p.section-subtitle #{settingWebsiteInfo.websiteName || 'TitiSport'} tự hào phân phối chính hãng các thương hiệu dụng cụ và trang phục thi đấu hàng đầu thế giới.

      .brands-grid
        if brandList && brandList.length > 0
          each item in brandList
            a.brand-card(href=(item.link || `/?keyword=${item.name}`))
              .brand-card__logo-wrap
                if item.logo
                  img.brand-card__logo-img(src=item.logo alt=`${item.name} Logo` loading="lazy")
                else
                  i.fa-solid.fa-certificate.brand-card__fallback-icon
              h4.brand-card__name= item.name
              if item.tagline
                span.brand-card__tagline= item.tagline
              if item.specPill
                span.brand-spec-pill
                  i.fa-solid.fa-medal
                  | #{item.specPill}
              if item.description
                p.brand-card__desc= item.description
              .brand-card__footer
                span.brand-card__badge
                  i.fa-solid.fa-circle-check
                  | Phân Phối Chính Hãng
                span.brand-view-link
                  | Xem Sản Phẩm
                  i.fa-solid.fa-arrow-right

        a.brand-card(href="/product")
          .brand-card__logo-wrap
            if settingWebsiteInfo.logo
              img.brand-card__logo-img(src=settingWebsiteInfo.logo alt=settingWebsiteInfo.websiteName loading="lazy")
            else
              i.fa-solid.fa-shield-halved.brand-card__fallback-icon
          h4.brand-card__name #{settingWebsiteInfo.websiteName || 'TITISPORT'} PRO
          span.brand-card__tagline Gian Hàng Chính Hãng
          span.brand-spec-pill
            i.fa-solid.fa-fire-flame-curved
            | Dụng Cụ & Phụ Kiện
          p.brand-card__desc Phụ kiện thể thao chọn lọc, túi đựng bóng, tất thi đấu chống trơn cao cấp.
          .brand-card__footer
            span.brand-card__badge.badge-vip
              i.fa-solid.fa-star
              | Độc Quyền
            span.brand-view-link
              | Xem Sản Phẩm
              i.fa-solid.fa-arrow-right

  script(src="/client/assets/js/flash-sale.js")