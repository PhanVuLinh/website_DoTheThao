extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main 
  +box-breadcrumb(breadcrumb)
  section.product-detail-page
    .container
      .detail-grid
        .detail-left
          .detail-card.product-image-card
            if productDetail.images && productDetail.images.length > 0
              .swiper.main-swiper
                .swiper-wrapper
                  each img in productDetail.images
                    .swiper-slide
                      img(src=img, alt=productDetail.title)
                if productDetail.images.length > 1
                  .swiper-button-next
                  .swiper-button-prev
              if productDetail.images.length > 1
                .swiper.thumb-swiper
                  .swiper-wrapper
                    each img in productDetail.images
                      .swiper-slide
                        img(src=img, alt=productDetail.title)
            else if productDetail.thumbnail
              .gallery-main
                img(src=productDetail.thumbnail, alt=productDetail.title)
            else
              .gallery-main
                img(src="/client/assets/images/default-thumbnail.jpg", alt=productDetail.title)

          .detail-card.info-card
            h3.card-title
              i.fa-solid.fa-circle-info
              | Thông Tin Chi Tiết
            .info-desc !{productDetail.description || 'Đang cập nhật thông tin chi tiết.'}

          //- Đánh giá & Nhận xét sản phẩm (Verified Buyer Reviews)
          .detail-card.reviews-card#reviews-section
            .reviews-header
              h3.card-title
                i.fa-solid.fa-star-half-stroke
                | Đánh Giá Từ Khách Hàng (#{totalReviews})
              if isVerifiedBuyer
                span.verified-badge-top
                  i.fa-solid.fa-shield-heart
                  | Đã mua sản phẩm này

            .reviews-summary-grid
              .summary-score-box
                .big-score #{avgRating}
                .score-stars
                  - for (var i = 1; i <= 5; i++)
                    i.fa-solid.fa-star(class=(i <= Math.round(parseFloat(avgRating)) ? 'filled' : 'empty'))
                .total-count #{totalReviews} lượt đánh giá thực tế

              .summary-bars-box
                each starNum in [5, 4, 3, 2, 1]
                  - var count = ratingBreakdown[starNum] || 0;
                  - var percent = totalReviews > 0 ? Math.round((count / totalReviews) * 100) : 0;
                  .rating-bar-row
                    span.star-label #{starNum} ★
                    .bar-track
                      .bar-fill(style=`width: ${percent}%`)
                    span.count-label #{count}

            //- Form viết đánh giá
            if isUserLoggedIn
              .write-review-box
                h4.write-title
                  i.fa-solid.fa-pen-to-square
                  | Gửi đánh giá của bạn
                if isVerifiedBuyer
                  p.verified-hint
                    i.fa-solid.fa-circle-check
                    | Bạn đã mua sản phẩm này. Đánh giá của bạn sẽ được gắn huy hiệu <strong>Người mua xác thực</strong>!
                form.review-form(action="/review/create" method="POST" enctype="multipart/form-data")
                  input(type="hidden" name="productId" value=productDetail._id)
                  .form-group-rating
                    label Chọn số sao đánh giá:
                    .star-rating-select
                      input#star5(type="radio" name="rating" value="5" checked)
                      label(for="star5" title="5 sao - Tuyệt vời") ★
                      input#star4(type="radio" name="rating" value="4")
                      label(for="star4" title="4 sao - Rất tốt") ★
                      input#star3(type="radio" name="rating" value="3")
                      label(for="star3" title="3 sao - Bình thường") ★
                      input#star2(type="radio" name="rating" value="2")
                      label(for="star2" title="2 sao - Kém") ★
                      input#star1(type="radio" name="rating" value="1")
                      label(for="star1" title="1 sao - Rất tệ") ★

                  .form-group
                    label(for="reviewComment") Nhận xét chi tiết:
                    textarea#reviewComment.form-control(name="comment" rows="3" placeholder="Chia sẻ cảm nhận về chất liệu, độ vừa vặn, độ bền của sản phẩm..." required)

                  .form-group
                    label Tải ảnh thực tế (Tối đa 3 ảnh):
                    input#reviewImages(type="file" name="images" multiple accept="image/*" class="form-control-file")

                  button.btn-submit-review(type="submit")
                    i.fa-solid.fa-paper-plane
                    | GỬI ĐÁNH GIÁ NGAY
            else
              .login-to-review-alert
                i.fa-solid.fa-lock
                span Vui lòng <a href="/auth/login">Đăng nhập</a> để viết đánh giá cho sản phẩm này.

            //- Danh sách các đánh giá
            .reviews-list
              if reviews && reviews.length > 0
                each item in reviews
                  .review-item
                    .review-item__header
                      .user-info
                        img.user-avatar(src=item.avatar || "/client/assets/images/default-avatar.png" alt=item.fullName)
                        .user-meta
                          strong.user-name #{item.fullName}
                          if item.isVerifiedBuyer
                            span.buyer-badge
                              i.fa-solid.fa-circle-check
                              | Đã mua hàng tại SportStore
                      .review-time #{item.createdAtFormat}
                    
                    .review-item__rating
                      - for (var i = 1; i <= 5; i++)
                        i.fa-solid.fa-star(class=(i <= item.rating ? 'filled' : 'empty'))

                    .review-item__content
                      p #{item.comment}

                    if item.images && item.images.length > 0
                      .review-item__gallery
                        each rImg in item.images
                          a.gallery-thumb(href=rImg target="_blank")
                            img(src=rImg alt="Ảnh đánh giá")
              else
                .no-reviews-box
                  i.fa-regular.fa-comment-dots
                  p Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!

        // --- CỘT PHẢI: FORM ĐẶT HÀNG ---
        .detail-right
          form(
            action=`/cart/add/${productDetail._id || productDetail.id}`
            method="POST"
          )
            .booking-card
              
              .product-header
                h1.product-title= productDetail.title
                
                .product-meta-top
                  .stars
                    - for (var i = 1; i <= 5; i++)
                      i.fa-solid.fa-star(class=(i <= Math.round(parseFloat(avgRating)) ? 'filled' : 'empty'))
                    span.rating-score-text #{avgRating} (#{totalReviews} đánh giá)
                  if productDetail.brand
                    span.divider |
                    .brand-info
                      span Thương hiệu: 
                      strong #{productDetail.brand}
                  span.divider |
                  .status
                    i.fa-solid.fa-check-circle
                    | Còn hàng

              .price-wrap(data-base-price=productDetail.price data-base-price-new=(productDetail.priceNew || productDetail.price))
                if productDetail.discountPercentage > 0
                  span.price-old #{productDetail.price.toLocaleString('vi-VN')}đ
                  span.price-new #{productDetail.priceNew.toLocaleString('vi-VN')}đ
                  span.discount-tag -#{productDetail.discountPercentage}%
                else
                  span.price-new #{productDetail.price.toLocaleString('vi-VN')}đ

              .form-group.size-selection
                .size-header-row
                  label.size-title Kích Thước (Size)
                  button.btn-open-size-guide(type="button" id="btnOpenSizeGuide")
                    i.fa-solid.fa-ruler-combined
                    span Bảng quy đổi kích cỡ
                
                - var firstAvailableIndex = 0;
                - if (productDetail.sizes && productDetail.sizes.length > 0) {
                -   var foundIdx = productDetail.sizes.findIndex(s => s.stock > 0);
                -   if (foundIdx !== -1) firstAvailableIndex = foundIdx;
                - }

                .filter-grid-size
                  if productDetail.sizes && productDetail.sizes.length > 0
                    each item, index in productDetail.sizes
                      - var isOutOfStock = (item.stock <= 0);
                      div.size-item(class=(isOutOfStock ? 'is-out-of-stock' : ''))
                        input(
                          type="radio", 
                          id=`size-opt-${index}`, 
                          name="size", 
                          value=item.size, 
                          checked=(index === firstAvailableIndex), 
                          data-stock=item.stock,
                          disabled=isOutOfStock
                        )
                        label.size-btn(for=`size-opt-${index}` class=(isOutOfStock ? 'disabled' : ''))
                          span.size-val #{item.size.replace(/^size[:\s]*/i, "")}
                          if isOutOfStock
                            span.size-sub-oos Hết
                  else 
                    p.text-danger Sản phẩm tạm hết hàng.

              .form-group.qty-selection
                label Số lượng
                
                - var initialStock = productDetail.sizes && productDetail.sizes.length > 0 ? productDetail.sizes[firstAvailableIndex].stock : 0;
                
                .qty-control-wrapper
                  .qty-custom
                    button.btn-qty-custom.minus(type="button") -
                    input#quantity(type="text",name="quantity", value="1", readonly)
                    button.btn-qty-custom.plus(type="button") +
                  
                  .stock-status-container
                    span.stock-info#stock-info-wrap(style=(initialStock <= 3 ? "display: none;" : "display: inline-flex;"))
                      span.stock-text Còn
                      strong#current-stock #{initialStock}
                      span.stock-unit sản phẩm
                    
                    span#low-stock-alert.low-stock-pill(
                      class=(initialStock <= 0 ? "pill-danger" : "pill-warning pill-pulse")
                      style=(initialStock <= 3 ? "display: inline-flex;" : "display: none;")
                    )
                      if initialStock <= 0
                        i.fa-solid.fa-circle-xmark
                        span.pill-text Tạm hết hàng
                      else
                        i.fa-solid.fa-fire-flame-curved
                        span.pill-text Chỉ còn #{initialStock} sản phẩm!

              .detail-action-buttons
                button.btn-submit-cart(type="submit" id="btnAddToCart")
                  i.fa-solid.fa-cart-plus
                  span Thêm Vào Giỏ Hàng
                button.btn-wishlist-detail(
                  type="button"
                  id="btnWishlistDetail"
                  data-id=(productDetail.id || productDetail._id)
                  data-title=productDetail.title
                  data-slug=productDetail.slug
                  data-price=(productDetail.priceNew || productDetail.price)
                  data-price-old=productDetail.price
                  data-thumbnail=productDetail.thumbnail
                  title="Thêm vào danh sách yêu thích"
                )
                  i.fa-regular.fa-heart
                  span Yêu thích

              .trust-badges
                .trust-item
                  .icon-box
                    i.fa-solid.fa-truck-fast
                  span= (settingWebsiteInfo && settingWebsiteInfo.trustBadge1_title) ? settingWebsiteInfo.trustBadge1_title : "Giao hàng hỏa tốc trong 2H"
                
                .trust-item
                  .icon-box
                    i.fa-solid.fa-certificate
                  span= (settingWebsiteInfo && settingWebsiteInfo.trustBadge2_title) ? settingWebsiteInfo.trustBadge2_title : "100% Hàng chính hãng"
                
                .trust-item
                  .icon-box
                    i.fa-solid.fa-rotate-left
                  span= (settingWebsiteInfo && settingWebsiteInfo.trustBadge3_title) ? settingWebsiteInfo.trustBadge3_title : "Đổi trả miễn phí 30 ngày"

                if settingWebsiteInfo && settingWebsiteInfo.trustBadge4_title
                  .trust-item
                    .icon-box
                      i.fa-solid.fa-headset
                    span= settingWebsiteInfo.trustBadge4_title

    //- SIZE GUIDE MODAL
    .size-guide-modal-backdrop#sizeGuideModal(style="display: none;")
      .size-guide-modal-dialog
        .size-guide-modal-header
          .modal-title-group
            i.fa-solid.fa-ruler-combined
            h3 Bảng Hướng Dẫn & Quy Đổi Kích Cỡ
          button.btn-close-modal(type="button" id="btnCloseSizeGuide" aria-label="Đóng")
            i.fa-solid.fa-xmark

        .size-guide-modal-body
          .guide-tabs-nav
            button.guide-tab-btn.active(type="button" data-target="tabFootwear")
              i.fa-solid.fa-shoe-prints
              | Giày Thể Thao
            button.guide-tab-btn(type="button" data-target="tabApparel")
              i.fa-solid.fa-shirt
              | Quần Áo Thể Thao

          //- SMART CALCULATOR WIDGET
          .size-calculator-widget
            h4
              i.fa-solid.fa-wand-magic-sparkles
              | Gợi ý kích cỡ thông minh cho bạn
            .calc-inputs-row#calcFootwearInputs
              .calc-field
                label Chiều dài bàn chân (cm):
                input#calcFootLength(type="number" step="0.1" min="20" max="32" placeholder="Ví dụ: 25.5")
              button.btn-calc-apply(type="button" id="btnCalcShoeSize")
                | Tính size ngay
            
            .calc-inputs-row#calcApparelInputs(style="display: none;")
              .calc-field
                label Chiều cao (cm):
                input#calcHeight(type="number" min="140" max="210" placeholder="Ví dụ: 172")
              .calc-field
                label Cân nặng (kg):
                input#calcWeight(type="number" min="35" max="130" placeholder="Ví dụ: 68")
              button.btn-calc-apply(type="button" id="btnCalcApparelSize")
                | Tính size ngay

            .calc-result-box#calcResultBox(style="display: none;")
              span.result-label Size gợi ý:
              strong.result-size#suggestedSizeBadge --
              button.btn-apply-suggested-size(type="button" id="btnApplySuggestedSize")
                i.fa-solid.fa-check
                | Áp dụng kích cỡ này

          //- TAB CONTENT 1: FOOTWEAR
          .guide-tab-content.active#tabFootwear
            .table-responsive-guide
              table.guide-table
                thead
                  tr
                    th Chiều dài chân (cm)
                    th Size EU / VN
                    th Size US
                    th Size UK
                tbody
                  tr
                    td 22.5 - 23.0
                    td.highlight 36
                    td 4.5
                    td 4.0
                  tr
                    td 23.1 - 23.5
                    td.highlight 37
                    td 5.5
                    td 5.0
                  tr
                    td 23.6 - 24.0
                    td.highlight 38
                    td 6.0
                    td 5.5
                  tr
                    td 24.1 - 24.5
                    td.highlight 39
                    td 7.0
                    td 6.0
                  tr
                    td 24.6 - 25.0
                    td.highlight 40
                    td 7.5
                    td 7.0
                  tr
                    td 25.1 - 25.5
                    td.highlight 41
                    td 8.5
                    td 7.5
                  tr
                    td 25.6 - 26.0
                    td.highlight 42
                    td 9.0
                    td 8.5
                  tr
                    td 26.1 - 26.5
                    td.highlight 43
                    td 10.0
                    td 9.5
                  tr
                    td 26.6 - 27.0
                    td.highlight 44
                    td 10.5
                    td 10.0
                  tr
                    td 27.1 - 27.5
                    td.highlight 45
                    td 11.5
                    td 11.0

          //- TAB CONTENT 2: APPAREL
          .guide-tab-content#tabApparel
            .table-responsive-guide
              table.guide-table
                thead
                  tr
                    th Size Chuẩn
                    th Chiều cao (cm)
                    th Cân nặng (kg)
                    th Vòng ngực (cm)
                tbody
                  tr
                    td.highlight S
                    td 155 - 165
                    td 48 - 56
                    td 84 - 88
                  tr
                    td.highlight M
                    td 164 - 172
                    td 57 - 65
                    td 88 - 94
                  tr
                    td.highlight L
                    td 170 - 177
                    td 66 - 74
                    td 94 - 100
                  tr
                    td.highlight XL
                    td 175 - 183
                    td 75 - 84
                    td 100 - 106
                  tr
                    td.highlight XXL
                    td 180 - 190
                    td 85 - 95
                    td 106 - 114

