extends ../layouts/default.pug
include ../mixins/product-item.pug
include ../mixins/pagination.pug

block main
  section.product-list-page.search-result-page
    .container
      .product-list-page__inner

        aside.product-filter
          form(action="/search" method="GET")
            if keyword
              input(type="hidden" name="keyword" value=keyword)

            .product-filter__header
              i.fa-solid.fa-filter
              h3.filter-title Bộ Lọc Tìm Kiếm
              
            .filter-group
              h4.filter-group-title Khoảng Giá
              ul.filter-list
                li
                  label
                    input(type="radio" name="price" value="under-1m" checked=(queryPrice === "under-1m"))
                    span Dưới 1 Triệu
                li
                  label
                    input(type="radio" name="price" value="1m-to-3m" checked=(queryPrice === "1m-to-3m"))
                    span 1 Triệu - 3 Triệu
                li
                  label
                    input(type="radio" name="price" value="over-3m" checked=(queryPrice === "over-3m"))
                    span Trên 3 Triệu

            if availableBrands && availableBrands.length > 0
              .filter-group
                h4.filter-group-title Thương Hiệu
                ul.filter-list
                  each b in availableBrands
                    li
                      label
                        input(type="checkbox" name="brand" value=b checked=(queryBrand && (Array.isArray(queryBrand) ? queryBrand.includes(b) : queryBrand === b)))
                        span #{b}

            if querySort
              input(type="hidden" name="sort" value=querySort)

            .filter-actions
              button.btn-apply-filter(type="submit") 
                i.fa-solid.fa-filter
                | Áp Dụng
              if keyword
                a.btn-clear-filter(href=`/search?keyword=${encodeURIComponent(keyword)}`) 
                  i.fa-solid.fa-rotate-right
                  | Xóa Lọc

        main.product-content
          
          .search-header
            h1.search-title 
              | Kết quả tìm kiếm cho: 
              span.keyword "#{keyword || 'Tất cả sản phẩm'}"
            p.search-count 
              | Tìm thấy 
              strong #{totalCount !== undefined ? totalCount : (productList ? productList.length : 0)} 
              | sản phẩm phù hợp

          if productList && productList.length > 0
            .product-content__header.search-sort-header
              .header-info
                p.desc Hiển thị <strong>#{productList.length}</strong> trên tổng số <strong>#{totalCount !== undefined ? totalCount : productList.length}</strong> sản phẩm
              .header-sort
                span Sắp xếp theo:
                select.sort-select(name="sort" id="sort-select")
                  option(value="newest" selected=(querySort === "newest" || !querySort)) Mới Nhất
                  option(value="price-asc" selected=(querySort === "price-asc")) Giá tăng dần
                  option(value="price-desc" selected=(querySort === "price-desc")) Giá giảm dần
            
            .product-content__grid
              each item in productList
                +productItem(item)

            +pagination(pagination)
          
          else
            .empty-search
              .empty-icon
                i.fa-solid.fa-magnifying-glass-minus
              h3 Không tìm thấy kết quả nào!
              p Rất tiếc, chúng tôi không tìm thấy sản phẩm nào phù hợp với từ khóa <strong>"#{keyword}"</strong>.
              a.btn-explore-now(href="/category/bong-da") 
                i.fa-solid.fa-shop
                | Khám phá sản phẩm hot