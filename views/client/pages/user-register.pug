extends ../layouts/default.pug

block main
  .auth-page
    .container
      .auth-box
        h2.auth-title Tạo Tài Khoản
        p.auth-subtitle Mua sắm dễ dàng và nhận nhiều ưu đãi hơn.
        
        form(action="/auth/register" method="POST")
          .form-group
            label(for="fullName") Họ và Tên <span class="text-danger">*</span>
            input#fullName.form-control(
              type="text" 
              name="fullName" 
              placeholder="Nhập họ và tên" 
              value=oldData.fullName || ""
              required
              minlength="2"
            )

          .form-group
            label(for="email") Email <span class="text-danger">*</span>
            input#email.form-control(
              type="email" 
              name="email" 
              placeholder="Ví dụ: name@gmail.com" 
              value=oldData.email || ""
              required
            )
            
          .form-group
            label(for="password") Mật khẩu <span class="text-danger">*</span>
            input#password.form-control(
              type="password" 
              name="password" 
              placeholder="Tạo mật khẩu (tối thiểu 6 ký tự)" 
              required
              minlength="6"
            )

          .form-group
            label(for="confirmPassword") Xác nhận mật khẩu <span class="text-danger">*</span>
            input#confirmPassword.form-control(
              type="password" 
              name="confirmPassword" 
              placeholder="Nhập lại mật khẩu" 
              required
              data-match="#password"
            )
            
          button.btn-auth(type="submit") 
            | Đăng Ký
            
        .auth-redirect
          | Đã có tài khoản? 
          a(href="/auth/login") Đăng nhập