extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
  +box-breadcrumb(breadcrumb)

  .contact-page(style="padding: 40px 0 80px; background: #f8fafc;")
    .container(style="max-width: 1240px; margin: 0 auto; padding: 0 16px;")
      
      //- Header
      .contact-page__header(style="text-align: center; margin-bottom: 40px;")
        span(style="display: inline-flex; align-items: center; gap: 8px; background: rgba(225, 29, 72, 0.08); color: #e11d48; font-size: 13px; font-weight: 700; padding: 6px 16px; border-radius: 50px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;")
          i.fa-solid.fa-headset
          | TRUNG TÂM HỖ TRỢ KHÁCH HÀNG
        h1(style="font-size: 32px; font-weight: 800; color: #0f172a; margin-bottom: 10px; font-family: 'Plus Jakarta Sans', sans-serif;") Liên Hệ Với #{settingWebsiteInfo && settingWebsiteInfo.websiteName ? settingWebsiteInfo.websiteName : "Chúng Tôi"}
        p(style="font-size: 15px; color: #64748b; max-width: 600px; margin: 0 auto; line-height: 1.6;")
          | Chúng tôi luôn sẵn sàng lắng nghe và giải đáp mọi thắc mắc của quý khách 24/7. Hãy liên hệ với chúng tôi qua các kênh dưới đây hoặc để lại tin nhắn.

      //- 2 Columns Grid
      .contact-page__grid(style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;")
        
        //- CỘT 1: THÔNG TIN CỬA HÀNG & BẢN ĐỒ
        .contact-info-col(style="display: flex; flex-direction: column; gap: 24px;")
          
          //- Thẻ thông tin nhanh
          .contact-cards-grid(style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;")
            
            .contact-card(style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; display: flex; gap: 16px; align-items: flex-start;")
              .icon-box(style="width: 48px; height: 48px; border-radius: 12px; background: #fee2e2; color: #e11d48; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;")
                i.fa-solid.fa-phone-volume
              .card-body(style="flex: 1;")
                h4(style="font-size: 14px; font-weight: 700; color: #64748b; margin-bottom: 4px; text-transform: uppercase;") Hotline tư vấn
                p(style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0;")
                  if settingWebsiteInfo && (settingWebsiteInfo.hotline || settingWebsiteInfo.phone)
                    a(href=`tel:${settingWebsiteInfo.hotline || settingWebsiteInfo.phone}` style="color: #e11d48; text-decoration: none;") #{settingWebsiteInfo.hotline || settingWebsiteInfo.phone}
                  else
                    span 1900 6868

            .contact-card(style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; display: flex; gap: 16px; align-items: flex-start;")
              .icon-box(style="width: 48px; height: 48px; border-radius: 12px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;")
                i.fa-solid.fa-envelope-open-text
              .card-body(style="flex: 1;")
                h4(style="font-size: 14px; font-weight: 700; color: #64748b; margin-bottom: 4px; text-transform: uppercase;") Email hỗ trợ
                p(style="font-size: 15px; font-weight: 700; color: #0f172a; margin: 0; word-break: break-all;")
                  if settingWebsiteInfo && settingWebsiteInfo.email
                    a(href=`mailto:${settingWebsiteInfo.email}` style="color: #2563eb; text-decoration: none;") #{settingWebsiteInfo.email}
                  else
                    span hotro@sportstore.vn

            .contact-card(style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; display: flex; gap: 16px; align-items: flex-start;")
              .icon-box(style="width: 48px; height: 48px; border-radius: 12px; background: #f0fdf4; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;")
                i.fa-solid.fa-clock
              .card-body(style="flex: 1;")
                h4(style="font-size: 14px; font-weight: 700; color: #64748b; margin-bottom: 4px; text-transform: uppercase;") Giờ mở cửa
                p(style="font-size: 14px; font-weight: 600; color: #0f172a; margin: 0;") #{settingWebsiteInfo && settingWebsiteInfo.workingHours ? settingWebsiteInfo.workingHours : "08:00 - 22:00 (Tất cả các ngày)"}

            .contact-card(style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; display: flex; gap: 16px; align-items: flex-start;")
              .icon-box(style="width: 48px; height: 48px; border-radius: 12px; background: #fffbeb; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;")
                i.fa-solid.fa-location-dot
              .card-body(style="flex: 1;")
                h4(style="font-size: 14px; font-weight: 700; color: #64748b; margin-bottom: 4px; text-transform: uppercase;") Địa chỉ
                p(style="font-size: 14px; font-weight: 600; color: #0f172a; margin: 0; line-height: 1.4;") #{settingWebsiteInfo && settingWebsiteInfo.address ? settingWebsiteInfo.address : "Hệ thống cửa hàng thể thao trên toàn quốc"}

          //- Kênh mạng xã hội
          if settingWebsiteInfo && (settingWebsiteInfo.facebook || settingWebsiteInfo.instagram || settingWebsiteInfo.tiktok || settingWebsiteInfo.youtube || settingWebsiteInfo.zalo)
            .social-connect-box(style="background: #ffffff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;")
              div
                h4(style="font-size: 15px; font-weight: 700; color: #0f172a; margin: 0 0 4px;") Kết nối với chúng tôi
                p(style="font-size: 13px; color: #64748b; margin: 0;") Theo dõi các kênh chính thức để nhận ưu đãi
              .social-links(style="display: flex; gap: 10px;")
                if settingWebsiteInfo.facebook
                  a(href=settingWebsiteInfo.facebook target="_blank" rel="noopener noreferrer" style="width: 40px; height: 40px; border-radius: 10px; background: #1877f2; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px;")
                    i.fa-brands.fa-facebook-f
                if settingWebsiteInfo.instagram
                  a(href=settingWebsiteInfo.instagram target="_blank" rel="noopener noreferrer" style="width: 40px; height: 40px; border-radius: 10px; background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%); color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px;")
                    i.fa-brands.fa-instagram
                if settingWebsiteInfo.tiktok
                  a(href=settingWebsiteInfo.tiktok target="_blank" rel="noopener noreferrer" style="width: 40px; height: 40px; border-radius: 10px; background: #000000; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px;")
                    i.fa-brands.fa-tiktok
                if settingWebsiteInfo.youtube
                  a(href=settingWebsiteInfo.youtube target="_blank" rel="noopener noreferrer" style="width: 40px; height: 40px; border-radius: 10px; background: #ff0000; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px;")
                    i.fa-brands.fa-youtube
                if settingWebsiteInfo.zalo
                  a(href=settingWebsiteInfo.zalo target="_blank" rel="noopener noreferrer" style="width: 40px; height: 40px; border-radius: 10px; background: #0068ff; color: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 18px;")
                    i.fa-solid.fa-comment-dots

          //- Bản đồ Google Maps nhúng từ DB
          .map-wrapper(style="background: #ffffff; border-radius: 16px; padding: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; overflow: hidden;")
            if settingWebsiteInfo && settingWebsiteInfo.mapIframe
              .map-iframe-container(style="position: relative; width: 100%; border-radius: 12px; overflow: hidden; min-height: 280px;")
                | !{settingWebsiteInfo.mapIframe}
            else
              .map-placeholder(style="height: 280px; background: #f1f5f9; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #64748b; padding: 20px;")
                i.fa-solid.fa-map-location-dot(style="font-size: 40px; color: #94a3b8; margin-bottom: 12px;")
                h4(style="font-size: 16px; font-weight: 700; color: #334155; margin-bottom: 4px;") #{settingWebsiteInfo && settingWebsiteInfo.websiteName ? settingWebsiteInfo.websiteName : "SportStore"}
                p(style="font-size: 14px; margin: 0;") #{settingWebsiteInfo && settingWebsiteInfo.address ? settingWebsiteInfo.address : "123 Đường Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh"}

        //- CỘT 2: FORM LIÊN HỆ & GỬI TIN NHẮN
        .contact-form-col
          .contact-form-card(style="background: #ffffff; border-radius: 20px; padding: 36px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;")
            .card-header(style="margin-bottom: 24px;")
              h3(style="font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 6px;") Gửi Tin Nhắn Cho Chúng Tôi
              p(style="font-size: 14px; color: #64748b; margin: 0;") Điền thông tin vào mẫu bên dưới, chúng tôi sẽ liên hệ lại trong vòng 30 phút.

            form(action="/contact/create" method="POST")
              .form-group(style="margin-bottom: 20px;")
                label(style="display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 8px;") Họ và tên của bạn <span style="color: #e11d48;">*</span>
                .input-with-icon(style="position: relative;")
                  i.fa-solid.fa-user(style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8;")
                  input(type="text" name="fullName" placeholder="VD: Nguyễn Văn A" required style="width: 100%; padding: 12px 16px 12px 44px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#e11d48'" onblur="this.style.borderColor='#e2e8f0'")

              .form-group(style="margin-bottom: 20px;")
                label(style="display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 8px;") Số điện thoại liên hệ <span style="color: #e11d48;">*</span>
                .input-with-icon(style="position: relative;")
                  i.fa-solid.fa-phone(style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8;")
                  input(type="tel" name="phone" placeholder="VD: 0987 654 321" required style="width: 100%; padding: 12px 16px 12px 44px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#e11d48'" onblur="this.style.borderColor='#e2e8f0'")

              .form-group(style="margin-bottom: 20px;")
                label(style="display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 8px;") Địa chỉ Email <span style="color: #e11d48;">*</span>
                .input-with-icon(style="position: relative;")
                  i.fa-solid.fa-envelope(style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #94a3b8;")
                  input(type="email" name="email" placeholder="VD: email@example.com" required style="width: 100%; padding: 12px 16px 12px 44px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#e11d48'" onblur="this.style.borderColor='#e2e8f0'")

              .form-group(style="margin-bottom: 24px;")
                label(style="display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 8px;") Nội dung tin nhắn / Yêu cầu tư vấn <span style="color: #e11d48;">*</span>
                textarea(name="content" rows="4" placeholder="Nhập câu hỏi, thắc mắc về sản phẩm hoặc dịch vụ..." required style="width: 100%; padding: 12px 16px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; resize: vertical; transition: border-color 0.2s;" onfocus="this.style.borderColor='#e11d48'" onblur="this.style.borderColor='#e2e8f0'")

              button(type="submit" style="width: 100%; background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); color: #ffffff; padding: 14px 28px; border: none; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 4px 14px rgba(225, 29, 72, 0.3); transition: all 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'")
                i.fa-solid.fa-paper-plane
                | GỬI YÊU CẦU LIÊN HỆ
